{
    "_paket": "SNC_3R — Sığınak sahneleri (shelter konusu), 328; parça [3] / 11, bekleyen [1, 2, 4, 5, 6, 7, 8, 9, 10, 11] (çeviri: harici AI; kalite incelemesi yapılmadı)",
    "_dosya": "RadioData_lua",
    "satirlar": {
        "RD_ALifeLine_774ed63316a96a09": {
            "tr": "Burası kilise gibi sessiz."
        },
        "RD_ALifeLine_028864bc3e763601": {
            "tr": "Beni rahatsız eden de o."
        },
        "RD_ALifeLine_70d2fa6f67f54bb4": {
            "tr": "Kilise mi rahatsız ediyor seni?"
        },
        "RD_ALifeLine_0c1ff73b50da75fb": {
            "tr": "Pazar günü kilise, böyle sessiz, sonra biri öksürüyor."
        },
        "RD_ALifeLine_4f14a41066ea8ab6": {
            "tr": "Biri hep öksürür."
        },
        "RD_ALifeLine_0ad0309628d2fa5f": {
            "tr": "Buraya biraz su gelsin, lütfen."
        },
        "RD_ALifeLine_155a86c049c15578": {
            "tr": "Senin mataran var ya."
        },
        "RD_ALifeLine_1b4fe3fc370fb4b4": {
            "tr": "Boş, ben burada can çekişiyorum."
        },
        "RD_ALifeLine_181a2a1d01c66375": {
            "tr": "Can çekişiyormuş, ha. On dakikadır oradasın daha."
        },
        "RD_ALifeLine_2d08d42a56a963f2": {
            "tr": "Suyu yukarı çıkarın, şimdi yere yığılacak."
        },
        "RD_ALifeLine_4c139bf84ba12a6d": {
            "tr": "Hareket var, sol tarafta!"
        },
        "RD_ALifeLine_13aafcae2213ddb9": {
            "tr": "Kedi çıktı, boş ver, sadece kedi."
        },
        "RD_ALifeLine_148fb76f3c00c7f5": {
            "tr": "Hep kedi çıkıyor."
        },
        "RD_ALifeLine_4a0305b13ee0a90f": {
            "tr": "Kedi olmayana kadar."
        },
        "RD_ALifeLine_1ce3c3cd7e1f482e": {
            "tr": "Şşş, bırak baksınlar."
        },
        "RD_ALifeLine_6b52e3a17141d30a": {
            "tr": "Gözlerim yine o numarayı yapıyor, her şey hareket ediyor."
        },
        "RD_ALifeLine_5656c3ce61eb13a3": {
            "tr": "O yorgunluk."
        },
        "RD_ALifeLine_5e4e37a25441afb1": {
            "tr": "Hem de çok hareket ediyor."
        },
        "RD_ALifeLine_2ec8d28c452532ae": {
            "tr": "Otur, nöbeti ben alırım."
        },
        "RD_ALifeLine_3e12cb855beb36b2": {
            "tr": "Yıkılmadan otur şuraya."
        },
        "RD_ALifeLine_3a813a52710cd05a": {
            "tr": "Sanırım komşunun ışığı yanıyor."
        },
        "RD_ALifeLine_51dcf4ea131aa9a7": {
            "tr": "Hangi komşu?"
        },
        "RD_ALifeLine_1708a267158f6b7b": {
            "tr": "Karşıdaki, ikinci pencere. Az önce yanmıyordu."
        },
        "RD_ALifeLine_3589b43e1a2ad096": {
            "tr": "Titriyor mu?"
        },
        "RD_ALifeLine_19909fa17f30747e": {
            "tr": "Yok, sabit, öylece yanıyor."
        },
        "RD_ALifeLine_29166a593c7bc0f7": {
            "tr": "Orada biri var demek."
        },
        "RD_ALifeLine_66d522bb1c6fcadc": {
            "tr": "Birinin bacası tütüyor, dumanı görebiliyorsun."
        },
        "RD_ALifeLine_0e60432d6b137ed2": {
            "tr": "Kimin?"
        },
        "RD_ALifeLine_2e6a4f807539fde0": {
            "tr": "Bilmiyorum, birkaç ev ötede."
        },
        "RD_ALifeLine_525b001815a7064a": {
            "tr": "Demek bir tek biz değiliz."
        },
        "RD_ALifeLine_2ea906e90f897116": {
            "tr": "Evet, değiliz."
        },
        "RD_ALifeLine_7eccf8c1461ecccd": {
            "tr": "El sallama sakın."
        },
        "RD_ALifeLine_594eaf57597fad68": {
            "tr": "İyi misin orada?"
        },
        "RD_ALifeLine_4a56fbab31da23e3": {
            "tr": "Sessizsin."
        },
        "RD_ALifeLine_728a23e5487c67e2": {
            "tr": "Gözlüyorum."
        },
        "RD_ALifeLine_252a30c704dad9f0": {
            "tr": "Gözlemiyorsun, düşünüyorsun."
        },
        "RD_ALifeLine_476bf5fe75aaf47f": {
            "tr": "...İkisi de."
        },
        "RD_ALifeLine_7d9a4fe528e68292": {
            "tr": "Postu bir dakika bırak, ben bakarım."
        },
        "RD_ALifeLine_76467d4616393c7a": {
            "tr": "Aptalca bir şey sorabilir miyim?"
        },
        "RD_ALifeLine_641b0e5e06757662": {
            "tr": "Bunlardan biri kapıya dayanırsa, yani gerçekten dibine gelirse, herkesi mi uyandırayım, yoksa sadece seni mi?"
        },
        "RD_ALifeLine_5edd2f497dc60858": {
            "tr": "Sadece beni. Sonra ben ve beyzbol sopası bir bakarız."
        },
        "RD_ALifeLine_797d9b73093b8b9b": {
            "tr": "Beni de uyandır, gösteriyi severim."
        },
        "RD_ALifeLine_480565020597d681": {
            "tr": "Nöbetime yarım saat kaldı."
        },
        "RD_ALifeLine_5260a59b0f2fec10": {
            "tr": "Bir saattir yarım saat kalıyor."
        },
        "RD_ALifeLine_13aa392353f8b66b": {
            "tr": "Yirmi dakika kaldı, sayıyorum."
        },
        "RD_ALifeLine_3fafb52621dd7113": {
            "tr": "Yirmi dakika, hepimiz de öğrendik."
        },
        "RD_ALifeLine_226e331217de1f6c": {
            "tr": "Biri şuna bir saat alsın."
        },
        "RD_ALifeLine_2655935868c5f766": {
            "tr": "Güneş doğuyor, biraz turuncu."
        },
        "RD_ALifeLine_2bc58b6f545b3068": {
            "tr": "Hava sıcak olacak mı?"
        },
        "RD_ALifeLine_2cf41eb07ac8ba04": {
            "tr": "Şimdiden sıcak, gece yarısı bile sıcaktı."
        },
        "RD_ALifeLine_6b6554a42f7b8248": {
            "tr": "Yaz bu, sıcak olmaz da ne olur."
        },
        "RD_ALifeLine_3c0945a549bed6e5": {
            "tr": "Dün de yemedin ama."
        },
        "RD_ALifeLine_4f7fe95e364419e1": {
            "tr": "Konserveyi yanına bırak."
        },
        "RD_ALifeLine_0c54a8871f729b77": {
            "tr": "Bugün toplam on kelime etmişsindir."
        },
        "RD_ALifeLine_4661900c63ce5e36": {
            "tr": "Ukala."
        },
        "RD_ALifeLine_6903c23c31c8deaa": {
            "tr": "Cuma'dan beri en çok konuştuğun an bu."
        },
        "RD_ALifeLine_69dc9b5c08d58bdd": {
            "tr": "Sürekli nereye gidiyorsun?"
        },
        "RD_ALifeLine_039087746f29a74f": {
            "tr": "Hiçbir yere."
        },
        "RD_ALifeLine_1b178ea76608a5b6": {
            "tr": "Kalkıyorsun, odanın ucuna kadar yürüyüp tekrar oturuyorsun."
        },
        "RD_ALifeLine_2fb2a35e48f48520": {
            "tr": "Geriniyorum."
        },
        "RD_ALifeLine_4c4da65417e570c0": {
            "tr": "Bir saattir mi?"
        },
        "RD_ALifeLine_77ab3a9b7f4b7281": {
            "tr": "Bırak."
        },
        "RD_ALifeLine_6a0a92d22ea7613c": {
            "tr": "Buraya oturmamda sakınca var mı?"
        },
        "RD_ALifeLine_23d16a992cf2f517": {
            "tr": "Konuşmayacağım."
        },
        "RD_ALifeLine_7bb55c3912e7d905": {
            "tr": "...sağ ol."
        },
        "RD_ALifeLine_39f4f5165476effd": {
            "tr": "Günlerdir duyduğum en güzel konuşma bu."
        },
        "RD_ALifeLine_2f872c4c3ef27ac7": {
            "tr": "Ellerin nasıl?"
        },
        "RD_ALifeLine_0d1a39034604aad1": {
            "tr": "İyi..."
        },
        "RD_ALifeLine_62787ee751f84be0": {
            "tr": "Titriyorlar."
        },
        "RD_ALifeLine_5f353f8a00df45ee": {
            "tr": "Kahveden."
        },
        "RD_ALifeLine_094bd2e97a30c41f": {
            "tr": "Kahvemiz yok."
        },
        "RD_ALifeLine_62ddbae42ba515f3": {
            "tr": "O zaman başka bir şeyden."
        },
        "RD_ALifeLine_5b824375439b0430": {
            "tr": "Bir dakika ver ona."
        },
        "RD_ALifeLine_13accb5f3f2143e6": {
            "tr": "Hiçbir şey değil o. Bütün gün şu duvara bakıp durdun."
        },
        "RD_ALifeLine_555b0d2e1355783a": {
            "tr": "Bırak, konuşacağı zaman konuşur."
        },
        "RD_ALifeLine_10930ed73be62992": {
            "tr": "Ne olduğunu anlatacağım demiştin."
        },
        "RD_ALifeLine_7eabde3317a665b5": {
            "tr": "O \"sonra\"nın üstünden üç gün geçti."
        },
        "RD_ALifeLine_52ee6c45540c1693": {
            "tr": "Demek ki hala sonra."
        },
        "RD_ALifeLine_60e6130e489918e2": {
            "tr": "Bırak artık, kaşıya kaşıya kanatacaksın."
        },
        "RD_ALifeLine_2aa1ac8a00df7d96": {
            "tr": "Biri bana bir zamanlar bir düğme vermişti."
        },
        "RD_ALifeLine_464f863c6657cc6d": {
            "tr": "Yerde bulmuş. Güzel bir düğme dedi."
        },
        "RD_ALifeLine_4edd3b8b3df655f9": {
            "tr": "Onlara göre güzeldi. Bana bir şey vermek istemişlerdi."
        },
        "RD_ALifeLine_4c9a1ecc358b442b": {
            "tr": "Bu hafta duyduğum en tatlı şey bu."
        },
        "RD_ALifeLine_2d0a9ca540b1ad5c": {
            "tr": "Onunla konuşma, düşünüyor."
        },
        "RD_ALifeLine_68dadcde019ba620": {
            "tr": "Ne hakkında?"
        },
        "RD_ALifeLine_4f141c2375eb92ee": {
            "tr": "Bilmiyorum, o yüzden konuşmuyorum."
        },
        "RD_ALifeLine_4c4f4cf35f453010": {
            "tr": "Ayıp şimdi."
        },
        "RD_ALifeLine_379a9eb7722d2b36": {
            "tr": "Kibarlık, düşünen insanı rahat bırakmaktır.",
            "onayli_uslup_istisnalari": {
                "dir": "Doğal konuşma -dır: tahmin (belki iyidir) ya da genel yargı (akıllıdır, ...maktır)."
            }
        },
        "RD_ALifeLine_035c17125da2c25c": {
            "tr": "Bütün gün o köşede mi oturacaksın?"
        },
        "RD_ALifeLine_6fb7394f5c725403": {
            "tr": "Muhtemelen..."
        },
        "RD_ALifeLine_0fbb459616179e5c": {
            "tr": "Neden o köşe?"
        },
        "RD_ALifeLine_1c4fffd92b90f6b8": {
            "tr": "İki duvarı var, arkamdan da kimse gelemez."
        },
        "RD_ALifeLine_1ca1caba02c8433e": {
            "tr": "Ben burada bile değilim."
        },
        "RD_ALifeLine_14aaf9fd53e4ba9b": {
            "tr": "Tam şuradasın."
        },
        "RD_ALifeLine_3c1858125e94bcd5": {
            "tr": "Burada değilim, okuyorum."
        },
        "RD_ALifeLine_34cb615b16fd8daa": {
            "tr": "Bir saattir aynı sayfadasın."
        },
        "RD_ALifeLine_0a8ad9cb554ab617": {
            "tr": "İyi bir sayfa."
        },
        "RD_ALifeLine_011f216a34bc83b8": {
            "tr": "Ne yazıyor?"
        },
        "RD_ALifeLine_195c6ea110b4aa61": {
            "tr": "Kardeşimle köşedeki koltuk için kapışırdık."
        },
        "RD_ALifeLine_52711a5969a1c0cc": {
            "tr": "Oturacak koca oda varken mi?"
        },
        "RD_ALifeLine_2490712631070503": {
            "tr": "En iyi cereyan oradaydı."
        },
        "RD_ALifeLine_37123a5b4061216d": {
            "tr": "İkimizin de hissedemediği bir cereyan için tartışırdık."
        },
        "RD_ALifeLine_588cf72906bf1e8f": {
            "tr": "Sonra annem paylaşın derdi. Yer bol, iki ahmak."
        },
        "RD_ALifeLine_617d85e20122ce09": {
            "tr": "Al, şunu tut."
        },
        "RD_ALifeLine_0555af677f233d6f": {
            "tr": "Ne bu?"
        },
        "RD_ALifeLine_459f006e1c825812": {
            "tr": "Soğuk kahve, dünden kalma, elimde bir tek o var."
        },
        "RD_ALifeLine_7d039fd24f832f98": {
            "tr": "Bir de battaniye ver ona."
        },
        "RD_ALifeLine_5b0ab2e05514ff08": {
            "tr": "Bugün bir şey öldürdüm."
        },
        "RD_ALifeLine_03f994372c53495b": {
            "tr": "Zaten ölüydü."
        },
        "RD_ALifeLine_6222da554850a613": {
            "tr": "Bir yüzü vardı."
        },
        "RD_ALifeLine_750491d368276d07": {
            "tr": "Biliyorum..."
        },
        "RD_ALifeLine_03e5fa82448dd935": {
            "tr": "İyi olduğunu biliyorum, yine de gel buraya..."
        },
        "RD_ALifeLine_68d93d790135066d": {
            "tr": "Ee, sonunda."
        },
        "RD_ALifeLine_48bfda190fc08fec": {
            "tr": "Ben-- şu sesi aklımdan çıkaramıyorum."
        },
        "RD_ALifeLine_0609dd172e396acf": {
            "tr": "Hangi ses?"
        },
        "RD_ALifeLine_13e8a9f21b6c4ac3": {
            "tr": "Kapı kapandığında kilidin çıkardığı ses."
        },
        "RD_ALifeLine_20c07fc404eb2afe": {
            "tr": "Yapman gerekeni yaptın."
        },
        "RD_ALifeLine_4db1120e63f24aac": {
            "tr": "Bunu deme, nefret ediyorum."
        },
        "RD_ALifeLine_2bf187147fc96ef2": {
            "tr": "Olur öyle, hakkın var."
        },
        "RD_ALifeLine_4479d8276e6d2bef": {
            "tr": "Yanında oturayım mı?"
        },
        "RD_ALifeLine_213bf85a1a912d06": {
            "tr": "Yok, evet, bilmem."
        },
        "RD_ALifeLine_4a8804c8638a62c2": {
            "tr": "Oturayım, bir şey söylemen gerekmez."
        },
        "RD_ALifeLine_45b0661a35d6b0e4": {
            "tr": "Tamam..."
        },
        "RD_ALifeLine_30ff12b5172a2cd7": {
            "tr": "Elimi tut, başım dönüyor."
        },
        "RD_ALifeLine_0b8821f5172f1c0c": {
            "tr": "Otur."
        },
        "RD_ALifeLine_6c024f3764a970ee": {
            "tr": "Kusacağım."
        },
        "RD_ALifeLine_0414d5be649e854a": {
            "tr": "Kus o zaman, saçını ben tutarım."
        },
        "RD_ALifeLine_700edca906d2050e": {
            "tr": "Uykunda ağladın."
        },
        "RD_ALifeLine_34a3592318667ed5": {
            "tr": "Öyle mi?"
        },
        "RD_ALifeLine_320810ec2650d715": {
            "tr": "Biraz, bir şey demedim, battaniyeyi tekrar üstüne örttüm."
        },
        "RD_ALifeLine_29fe603543e84ac2": {
            "tr": "Ben de sen örtmüşsündür diye düşünmüştüm."
        },
        "RD_ALifeLine_00b955865d98e373": {
            "tr": "Ben de duydum, kusura bakma, kimseyi uyandırmak istemedim."
        },
        "RD_ALifeLine_0d57abc71e22aa68": {
            "tr": "Az önceki için üzgünüm."
        },
        "RD_ALifeLine_2ce232de2f3d6673": {
            "tr": "Yok, haddimi aşmıştım."
        },
        "RD_ALifeLine_7dc2a8d42288735e": {
            "tr": "Hepimiz haddimizi aşıyoruz."
        },
        "RD_ALifeLine_0022b45566c6472a": {
            "tr": "Yine de üzgünüm."
        },
        "RD_ALifeLine_118c92a21c1a7480": {
            "tr": "Özrü kabul et, nadir bulunur..."
        },
        "RD_ALifeLine_60693708732f8a01": {
            "tr": "Şeftali yüzünden kızmak aptalcaydı."
        },
        "RD_ALifeLine_2755849c692bcde0": {
            "tr": "Mesele şeftali değildi."
        },
        "RD_ALifeLine_6e0c24fa161b96ac": {
            "tr": "Biliyorum..."
        },
        "RD_ALifeLine_711800da40ef2dab": {
            "tr": "Kilidi kontrol edip duruyorum."
        },
        "RD_ALifeLine_4b4bf3097577ec02": {
            "tr": "Kilitli."
        },
        "RD_ALifeLine_0ab1d0f97b23d29e": {
            "tr": "Biliyorum, kilitli olduğunu biliyorum, ben sadece-- bir kere daha."
        },
        "RD_ALifeLine_085b52350faf40d9": {
            "tr": "Hadi, kontrol et."
        },
        "RD_ALifeLine_0cd5af7620f25f79": {
            "tr": "Seninle ben de bakarım."
        },
        "RD_ALifeLine_4bf3d2536bc95997": {
            "tr": "Bugün biri hakkımda güzel bir şey söyledi."
        },
        "RD_ALifeLine_4c7878a233ba1a6f": {
            "tr": "Düzgün bir ateş yaktığımı söyledin."
        },
        "RD_ALifeLine_0a4262725afdc39d": {
            "tr": "Düzgün bir ateşti."
        },
        "RD_ALifeLine_0ae92918039ccf90": {
            "tr": "Gayet düzgün bir ateşti."
        },
        "RD_ALifeLine_77cb812c32e4c6e4": {
            "tr": "Ya yaşayamazsam..."
        },
        "RD_ALifeLine_3dd250c64a300f2e": {
            "tr": "Yaşarsın."
        },
        "RD_ALifeLine_010c48f340ecba03": {
            "tr": "Yaşayamazsam kardeşime söyle ki-- boş ver, o biliyor."
        },
        "RD_ALifeLine_73c131da3725e22e": {
            "tr": "Kendin söylersin."
        },
        "RD_ALifeLine_4b1d18413f09368f": {
            "tr": "Ayağın kötü görünüyor."
        },
        "RD_ALifeLine_08ca261f78688890": {
            "tr": "Softbol topu kadar olmuş."
        },
        "RD_ALifeLine_3887362177e820c3": {
            "tr": "Çok küçük bir softbol topu."
        },
        "RD_ALifeLine_645184581f05d7f5": {
            "tr": "Sarayım."
        },
        "RD_ALifeLine_13a8fd806e083874": {
            "tr": "Sar, ama olay çıkarma."
        },
        "RD_ALifeLine_2617ba245ede2822": {
            "tr": "Ayağı ben tutarım."
        },
        "RD_ALifeLine_7abddc526f02ada5": {
            "tr": "Çocuğa ne diyeceğimi bilememiş olmam aklımdan çıkmıyor."
        },
        "RD_ALifeLine_5e98ec466b81590d": {
            "tr": "O zaman uyuyordu."
        },
        "RD_ALifeLine_5fdb7bf77bc140d1": {
            "tr": "Uyanıp soracağını biliyordum."
        },
        "RD_ALifeLine_47156a2b286bdadc": {
            "tr": "Sana bilmediğini söylemeni söylemiştim."
        },
        "RD_ALifeLine_76b1b82964d4d09d": {
            "tr": "Söyleyebileceğim en kötü şey gibi gelmişti."
        },
        "RD_ALifeLine_115f911c16de7c6c": {
            "tr": "Buzdolabında birinin market listesi hala duruyor."
        },
        "RD_ALifeLine_2aa9d21462b5c7aa": {
            "tr": "Okuma."
        },
        "RD_ALifeLine_5ac9eefa1e7a3739": {
            "tr": "Süt, yumurta, ampul, kedi maması."
        },
        "RD_ALifeLine_0f52ddeb77a7d546": {
            "tr": "Kedileri varmış."
        },
        "RD_ALifeLine_4f2356bb38637ea0": {
            "tr": "Evyenin altında bir kase var, kedileri varmış."
        },
        "RD_ALifeLine_6403e5df73f63660": {
            "tr": "Kapının yanında bir köpek tasması var."
        },
        "RD_ALifeLine_73bf25bd4e9cf7fa": {
            "tr": "Köpek nerede?"
        },
        "RD_ALifeLine_334980470691b836": {
            "tr": "Bilmiyorum, bir kase var, boş."
        },
        "RD_ALifeLine_1e6deb0e643a4628": {
            "tr": "Belki iyidir.",
            "onayli_uslup_istisnalari": {
                "dir": "Doğal konuşma -dır: tahmin (belki iyidir) ya da genel yargı (akıllıdır, ...maktır)."
            }
        },
        "RD_ALifeLine_63cbc7050ea8703a": {
            "tr": "Köpekler akıllıdır.",
            "onayli_uslup_istisnalari": {
                "dir": "Doğal konuşma -dır: tahmin (belki iyidir) ya da genel yargı (akıllıdır, ...maktır)."
            }
        },
        "RD_ALifeLine_6a38f46c0a7f408f": {
            "tr": "Başkasının çoraplarını giyiyorum."
        },
        "RD_ALifeLine_761305b75678de74": {
            "tr": "Güzel çoraplar."
        },
        "RD_ALifeLine_07b356b90d10531c": {
            "tr": "Muhtemelen bir ölünün çorapları."
        },
        "RD_ALifeLine_79b3ef4a3ab3da61": {
            "tr": "Güzel bir ölünün çorapları."
        },
        "RD_ALifeLine_78f5fa1b479be054": {
            "tr": "Ölünün\" deme, \"önceki sahibinin\" de."
        },
        "RD_ALifeLine_35f1184d6c6c61c1": {
            "tr": "Şömine rafında bir fotoğraf var, hepsi aynı kazağı giymiş."
        },
        "RD_ALifeLine_0a43310730cf2c95": {
            "tr": "Mutlu görünüyorlar."
        },
        "RD_ALifeLine_19a86f692e0e81c4": {
            "tr": "Onu BIRAK!"
        },
        "RD_ALifeLine_505b5ea843b4245d": {
            "tr": "Yüzünü aşağı çevir, öyle kalsın."
        },
        "RD_ALifeLine_0be9d08f08161020": {
            "tr": "Duvarda bir takvim var, hala haziranda."
        },
        "RD_ALifeLine_0afd490c7050a33a": {
            "tr": "Kimse çevirmemiş."
        },
        "RD_ALifeLine_65d484533d106447": {
            "tr": "Meşguldüler."
        },
        "RD_ALifeLine_076dbcdd3b78f191": {
            "tr": "Çevir, belki iyi gelir."
        },
        "RD_ALifeLine_6eaafdc7327dd9df": {
            "tr": "Bir günlük buldum."
        },
        "RD_ALifeLine_210c50117236d842": {
            "tr": "Okumuyorum."
        },
        "RD_ALifeLine_65ec56654b91477e": {
            "tr": "Tam şu an okuyorsun."
        },
        "RD_ALifeLine_13ede7753289c126": {
            "tr": "Sadece ilk sayfa, Kevin diye bir çocuk hakkında."
        },
        "RD_ALifeLine_623403e153d3de70": {
            "tr": "Kevin'in nesi varmış?"
        },
        "RD_ALifeLine_51f06a682bb32e6e": {
            "tr": "Burada kim yaşadıysa dokuz kedisi varmış, kokudan belli."
        },
        "RD_ALifeLine_3f95056d655ee72b": {
            "tr": "Ben kedilerden anladım."
        },
        "RD_ALifeLine_6a17eb285204a029": {
            "tr": "Kanepenin altında."
        },
        "RD_ALifeLine_5334cb7f465aef77": {
            "tr": "O zaman on bir olur, merdivende de iki tane var."
        },
        "RD_ALifeLine_6818ee8d4c9ca309": {
            "tr": "Komodinin üstünde İncil var, bir sayfada açık."
        },
        "RD_ALifeLine_6d902dbf78ab0c39": {
            "tr": "Hangi sayfa?"
        },
        "RD_ALifeLine_5ba9464b4fcb9864": {
            "tr": "Mezmurlar, üstünde kahve halkası var."
        },
        "RD_ALifeLine_2fe18d2b3491f24b": {
            "tr": "Açık kalsın."
        },
        "RD_ALifeLine_3eea748b353a4715": {
            "tr": "Kalsın, ona elimi sürmem."
        },
        "RD_ALifeLine_76b137ed04e2bf29": {
            "tr": "Tavanında yıldızlar olan bir çocuk odası hatırlıyorum."
        },
        "RD_ALifeLine_4f9817f075e916a1": {
            "tr": "Şu karanlıkta parlayanlar."
        },
        "RD_ALifeLine_2469ec1227d4f7f6": {
            "tr": "Denedim.. hala parlıyorlardı."
        },
        "RD_ALifeLine_575d3d8e65bb32a3": {
            "tr": "Ben karışmazdım onlara."
        },
        "RD_ALifeLine_43b951c52aa5a90e": {
            "tr": "Karışmadım.. sadece görmek istedim."
        },
        "RD_ALifeLine_09bd1f9f0626f133": {
            "tr": "Ben de görmek isterdim."
        },
        "RD_ALifeLine_14e5e1cf5580b48d": {
            "tr": "Biri ocakta tencere bırakmış."
        },
        "RD_ALifeLine_08e975f41fdf59b7": {
            "tr": "Dokunma."
        },
        "RD_ALifeLine_15d57023228aea7e": {
            "tr": "Sadece çorba, katılaşmış."
        },
        "RD_ALifeLine_65face4c0d8ee255": {
            "tr": "Kapağını kapat, öyle bırak."
        },
        "RD_ALifeLine_3c4983463249b7af": {
            "tr": "O mutfakta başka hiçbir şey açma."
        },
        "RD_ALifeLine_2ce36bbd0aff1c59": {
            "tr": "İlk nöbeti ben alırım. Gece yarısı Doyle'u uyandır, dörde kadar o tutar."
        },
        "RD_ALifeLine_17071c586f624782": {
            "tr": "Ya ben?"
        },
        "RD_ALifeLine_322975f66a10e39b": {
            "tr": "Sen dörtten sabaha kadar."
        },
        "RD_ALifeLine_09be853d0288cbbd": {
            "tr": "Tabii ki ben, en kötüsü."
        },
        "RD_ALifeLine_60f9aaea099b23d0": {
            "tr": "Birinin yapması lazım."
        },
        "RD_ALifeLine_7c3f5adf63e2bc06": {
            "tr": "Kimse tek başına işemeye çıkmayacak."
        },
        "RD_ALifeLine_2261d09e7cc8b0e5": {
            "tr": "İşemeye birini mi götüreceğiz?"
        },
        "RD_ALifeLine_69e3dfe13b75d455": {
            "tr": "Hayatımda duyduğum en aptalca kural."
        },
        "RD_ALifeLine_6ec50b216cbda4b4": {
            "tr": "O zaman elini de tutmamı istersin."
        },
        "RD_ALifeLine_17932b817529ad0a": {
            "tr": "Ben seninle gelirim, zaten benim de gitmem lazım..."
        },
        "RD_ALifeLine_767b488e282dee0c": {
            "tr": "Botlar kapının yanında, bağcıklar açık, gitmemiz gerekirse diye."
        },
        "RD_ALifeLine_633179b9218a36f8": {
            "tr": "Ya gitmemiz gerekmezse?"
        },
        "RD_ALifeLine_75d519930c4b3eac": {
            "tr": "O zaman botların kapının yanında, rahat ol."
        },
        "RD_ALifeLine_78f4465079d38b42": {
            "tr": "Benimkiler ayağımda, şansa bırakmam."
        },
        "RD_ALifeLine_7721b5b53723a7f4": {
            "tr": "Kapının yanında yatıyorum."
        },
        "RD_ALifeLine_1c58a037546ca01f": {
            "tr": "Yatamazsın, horluyorsun."
        },
        "RD_ALifeLine_64c90a1e0b7b365f": {
            "tr": "Ondan, içeri bir şey girerse benim yanımdan geçip seni bulur."
        },
        "RD_ALifeLine_1ef995505fc1d413": {
            "tr": "Ne dost adammışsın."
        },
        "RD_ALifeLine_0057c6c94e546dc5": {
            "tr": "Beni kapının yanına koy, ben horlamam."
        },
        "RD_ALifeLine_7bc57d6c2ec63b66": {
            "tr": "Bir şey olursa beni uyandır."
        },
        "RD_ALifeLine_0fb439974db3d0c6": {
            "tr": "Ne gibi?"
        },
        "RD_ALifeLine_26d0cfc63b59c88a": {
            "tr": "Güneş doğarsa uyandırayım mı?"
        },
        "RD_ALifeLine_5b0a0bfd0169e338": {
            "tr": "Yalnız kahve varsa."
        },
        "RD_ALifeLine_0aaa1d3f502f1a6e": {
            "tr": "Bu gece ateş yok."
        },
        "RD_ALifeLine_1c6596262281125b": {
            "tr": "Hava otuz iki derece, niye yakalım ki?",
            "not": "90 °F -> 32 °C"
        },
        "RD_ALifeLine_72c17a60507f289f": {
            "tr": "Biri hep ister."
        },
        "RD_ALifeLine_4e3d5f4968d112af": {
            "tr": "Kimse istemiyor."
        },
        "RD_ALifeLine_1d1e21250bd0f19b": {
            "tr": "Biri yakacak, hissediyorum."
        },
        "RD_ALifeLine_7cbd5f66726cdc34": {
            "tr": "Suyu karanlıkta bulabileceğimiz yere koy."
        },
        "RD_ALifeLine_2df2729143620f59": {
            "tr": "Neresi o?"
        },
        "RD_ALifeLine_7412c0e34a2f99ee": {
            "tr": "Tam şurası, kafamın yanı."
        },
        "RD_ALifeLine_5a1cad3477d835b3": {
            "tr": "Kafanın yanında ki hepsini sen içesin."
        },
        "RD_ALifeLine_666abc6a1d81d4e0": {
            "tr": "Tesadüf işte."
        },
        "RD_ALifeLine_0ad45b3153156a31": {
            "tr": "Karanlıktan sonra sessiz saat: konuşma yok, mırıldanma yok."
        },
        "RD_ALifeLine_0819b18f059d6e80": {
            "tr": "Beni diyorsun."
        },
        "RD_ALifeLine_10bdbc7431155eed": {
            "tr": "Herkesi diyorum ama evet, seni."
        },
        "RD_ALifeLine_520584a9061d6574": {
            "tr": "Mırıldanıyorsun."
        },
        "RD_ALifeLine_412ad6f137ea4109": {
            "tr": "Yarın taşınıyoruz."
        },
        "RD_ALifeLine_23802f8e3ec26630": {
            "tr": "Belli değil."
        },
        "RD_ALifeLine_2fec6863672051bd": {
            "tr": "O zaman karar ver, karar verilmemiş bir şeyin üstüne uyuyamam."
        },
        "RD_ALifeLine_60c4dc924a6f4ea2": {
            "tr": "Bırak da ben üstüne yatayım."
        },
        "RD_ALifeLine_0d6111dd058b6fbe": {
            "tr": "Arka kapıyı iki kez kontrol et."
        },
        "RD_ALifeLine_5ab5cc7431d5690d": {
            "tr": "Bir kere kontrol ettim."
        },
        "RD_ALifeLine_24130baa485beaf9": {
            "tr": "Böyle yapılır, iki kez kontrol edilir."
        },
        "RD_ALifeLine_3800fa963692f771": {
            "tr": "Aynı kapıyı iki kez kilitleyen adam söylüyor."
        },
        "RD_ALifeLine_11d67fbc060158dd": {
            "tr": "İyi bir çalışma yöntemi."
        },
        "RD_ALifeLine_7b40459c7c867422": {
            "tr": "Ya biri kapıyı çalarsa?"
        },
        "RD_ALifeLine_16831cde5cfa2024": {
            "tr": "Kimse çalmaz."
        },
        "RD_ALifeLine_196ebbc454ba0877": {
            "tr": "Ya çalarsa?"
        },
        "RD_ALifeLine_6d132ecc20fb2cb3": {
            "tr": "O zaman açmayız."
        },
        "RD_ALifeLine_44de81cc50940d4e": {
            "tr": "Çalmaya devam ederse?"
        },
        "RD_ALifeLine_3c8039821be9bc78": {
            "tr": "O zaman pompalıyla karşılarız."
        },
        "RD_ALifeLine_0d5ca3fd45c517e2": {
            "tr": "Kadranın öbür ucunu dene."
        },
        "RD_ALifeLine_0bdc02ad17924335": {
            "tr": "İki ucunu da denedim, ortayı da."
        },
        "RD_ALifeLine_3e6465b93f3dd0a5": {
            "tr": "Daha yukarı tut."
        },
        "RD_ALifeLine_3cf8e2d22cf64d94": {
            "tr": "Radyo öyle çalışmaz."
        },
        "RD_ALifeLine_26d144e96cf947e5": {
            "tr": "Dört tane D pil, yarısı bitmiş."
        },
        "RD_ALifeLine_04d49f1e50176ea0": {
            "tr": "Yani yarım radyo."
        },
        "RD_ALifeLine_58cf9ce6178601b0": {
            "tr": "Müziğe harcama."
        },
        "RD_ALifeLine_689e4623494b0259": {
            "tr": "Konuşuyorsa bir değeri var, o kadar."
        },
        "RD_ALifeLine_43ad8eca7350600e": {
            "tr": "Walkman'de bir kaset var, A yüzü kuzenimin karma kaseti, B yüzünde de şarkı aralarındaki konuşması."
        },
        "RD_ALifeLine_4a5552022eb3de14": {
            "tr": "B'yi çal."
        },
        "RD_ALifeLine_12997c7455ff375d": {
            "tr": "B'yi bir dakika çal, sadece bir dakika."
        },
        "RD_ALifeLine_6d35cee24eef07be": {
            "tr": "Yap, kimseye söylemem."
        },
        "RD_ALifeLine_0e7a38556e8c5d45": {
            "tr": "Geceleri AM'den Nashville'i yakalayabiliyorsun."
        },
        "RD_ALifeLine_7b0ba6a968d72d76": {
            "tr": "Nashville mi?"
        },
        "RD_ALifeLine_5261420469c0d098": {
            "tr": "Gökyüzünden sekip geliyor, uzun yollarda kamyonda dinlerdim."
        },
        "RD_ALifeLine_28e6b9512106e232": {
            "tr": "Bir şey çıktı mı?"
        },
        "RD_ALifeLine_5a32b92124de5e2a": {
            "tr": "İkinci el römork satan bir adam, hala, bütün bunların ortasında."
        },
        "RD_ALifeLine_30b1cc1d5e1fec32": {
            "tr": "İşte buna hizmet denir."
        },
        "RD_ALifeLine_3313f728711375ec": {
            "tr": "Biri CB'de on dokuzuncu kanalda tuşa basıp duruyor, tek kelime etmiyor."
        },
        "RD_ALifeLine_1a66093a505b4f93": {
            "tr": "Sadece nefes mi?"
        },
        "RD_ALifeLine_3876f8d662347620": {
            "tr": "Sadece tık, tık, tık, sanki konuşmak istiyor da konuşamıyor gibi."
        },
        "RD_ALifeLine_559641d7642321f4": {
            "tr": "Sen de bir şey söyle ona."
        },
        "RD_ALifeLine_0676f9955d85b13d": {
            "tr": "Söyledim, kimse cevap vermedi."
        },
        "RD_ALifeLine_5f5c8eae2f298140": {
            "tr": "Radyo içeride kalın dedi, sonra sustu."
        },
        "RD_ALifeLine_70e212113be1fb0b": {
            "tr": "Ne kadar süreyle dedi mi?"
        },
        "RD_ALifeLine_04a8bd707ba86df2": {
            "tr": "Yeni bir duyuruya kadar dedi, sonra sustu."
        },
        "RD_ALifeLine_5c79022d774844e6": {
            "tr": "Yeni duyuru ha. Güzel, komik."
        },
        "RD_ALifeLine_5ddd88d4189e158c": {
            "tr": "Yine o ses, uzun olan, test sesi."
        },
        "RD_ALifeLine_072d5e583d1868a8": {
            "tr": "Kapat şunu."
        },
        "RD_ALifeLine_5fdf5d855e482e64": {
            "tr": "Sonrasında bir şey diyebilir."
        },
        "RD_ALifeLine_4cb69e2b7ed0c180": {
            "tr": "Hiç demez, sadece bip bip bip diye öter durur."
        },
        "RD_ALifeLine_21b822ea30c03534": {
            "tr": "Kalsın, o bip sesini seviyorum."
        },
        "RD_ALifeLine_69761c3c2fb146d2": {
            "tr": "Duydun mu, bir ses."
        },
        "RD_ALifeLine_45f5f6b47aeb3c2f": {
            "tr": "Radyo, diyordu ki--"
        },
        "RD_ALifeLine_40c318bb1a72baa2": {
            "tr": "Ne diyordu?"
        },
        "RD_ALifeLine_74c7e06e41976e30": {
            "tr": "Gitti, gitti, \"kalın--\" dedi, sonra hiçbir şey."
        },
        "RD_ALifeLine_646eb7883cba118d": {
            "tr": "Kalın... ne? Nerede kalın?"
        },
        "RD_ALifeLine_613978c817604a47": {
            "tr": "Pilleri bitireceksin."
        },
        "RD_ALifeLine_2fec72a470a4580d": {
            "tr": "Pilleri bitireceğim."
        },
        "RD_ALifeLine_627e1f8713bfcd47": {
            "tr": "Ben de onu dedim."
        },
        "RD_ALifeLine_233fbf9e39a7b012": {
            "tr": "Ne dediğini biliyorum."
        },
        "RD_ALifeLine_32c5072b3bfeed26": {
            "tr": "Bir saatliğine kapat, bir şey gelmiyor."
        },
        "RD_ALifeLine_24854f74125cb7ae": {
            "tr": "Radyodaki beyzbol maçını hatırlıyor musun, bütün sokak açardı."
        },
        "RD_ALifeLine_4293064c3b3686d7": {
            "tr": "Sokakta yürürsün, tek atışı kaçırmazdın."
        },
        "RD_ALifeLine_58225f6954ed19dc": {
            "tr": "Bütün pencereler açık, bütün radyolar açık."
        },
        "RD_ALifeLine_4971af755f8f06d3": {
            "tr": "Şu an kötü bir maçı bile dinlerdim."
        },
        "RD_ALifeLine_2b0e43aa376301c9": {
            "tr": "Bana doğrultma."
        },
        "RD_ALifeLine_633228c566d54dcf": {
            "tr": "Dolu değil."
        },
        "RD_ALifeLine_527401e87f8636c7": {
            "tr": "Herkes öyle diyor."
        },
        "RD_ALifeLine_46e2b3c43511426f": {
            "tr": "Dolu değil, temizliyorum."
        },
        "RD_ALifeLine_5a0c56d11ebd3d9f": {
            "tr": "Odaya doğrultup temizliyorsun, ne güzel bir başlangıç."
        },
        "RD_ALifeLine_52213224453aa825": {
            "tr": "Kıpırdamıyorum ki."
        },
        "RD_ALifeLine_7b26169516e0dd80": {
            "tr": "Irkiliyorsun."
        },
        "RD_ALifeLine_189046903d2a59d7": {
            "tr": "İğne bu, başparmağıma batacak."
        },
        "RD_ALifeLine_493e704b484e1ab4": {
            "tr": "Düğme, parmak değil, düğmeyi tut."
        },
        "RD_ALifeLine_56f297ef41680bca": {
            "tr": "Su kaynıyor."
        },
        "RD_ALifeLine_67035f6324e9f0bd": {
            "tr": "Ne kadar?"
        },
        "RD_ALifeLine_659bd3a61a011341": {
            "tr": "On dakika, sonra dinlendir."
        },
        "RD_ALifeLine_61e7a3876b7c07a0": {
            "tr": "On dakika bir tencereye bakmak için uzun süre."
        },
        "RD_ALifeLine_37e6189b5d4e0e21": {
            "tr": "Bakma ona, bakılan tencere kaynamaz."
        },
        "RD_ALifeLine_4115b21e6226e88b": {
            "tr": "Kovada çorap yıkıyorum, hayatımda bu kadar mutlu olmamıştım."
        },
        "RD_ALifeLine_326a9f271fa13d74": {
            "tr": "Bir sabun buldum, koca bir sabun, neredeyse lavanta kokulu."
        },
        "RD_ALifeLine_6c03734a456a6d00": {
            "tr": "Senin adına çok sevindim."
        },
        "RD_ALifeLine_356a0b6d357f742a": {
            "tr": "İki çoraba yetecek kadar var mı?"
        }
    }
}