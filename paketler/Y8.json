      "tr": "Sokak bomboş, yağmacıların işi bitti."
    },
    "IGUI_ALifeUI_5a75df086b7cbf8a": {
      "tr": "Ortalık sakin, yağmacılar gitti."
    },
    "IGUI_ALifeUI_0147fe4d61590609": {
      "tr": "Yağmacı kalmadı, adamlarını kontrol et."
    },
    "IGUI_ALifeUI_0b3092b514faaf7b": {
      "tr": "Asker kalmadı, iş bitti."
    },
    "IGUI_ALifeUI_6993a2d57f37e9b2": {
      "tr": "Birlik gitti, teçhizatını kontrol et."
    },
    "IGUI_ALifeUI_6b8bc4ea32f550dc": {
      "tr": "Ortalık yine sakin, askerlerin işi bitti."
    },
    "IGUI_ALifeUI_574a1eb90c61533a": {
      "tr": "Bitti, memurlar gitti."
    },
    "IGUI_ALifeUI_60adaf223d2e3907": {
      "tr": "Polis gitti, kapıları kontrol et."
    },
    "IGUI_ALifeUI_70abcd0748d8ddc6": {
      "tr": "Memur kalmadı, yol sakin."
    },
    "IGUI_ALifeUI_25f148fd141e18c3": {
      "tr": "Silah sesleri kesildi, iş bitti."
    },
    "IGUI_ALifeUI_34d4a461249428a7": {
      "tr": "Ortalık yine sakin, eşyalarını kontrol et."
    },
    "IGUI_ALifeUI_7fa237142a847108": {
      "tr": "Yerliler gitti, artık bitti."
    },
    "IGUI_ALifeUI_059168da327de63c": {
      "tr": "SENİ GÖZETİM ALTINDA TUTTULAR"
    },
    "IGUI_ALifeUI_6c9ee90778e0c50d": {
      "tr": "Üste, nöbetçiler gelenleri kontrol ederken seni gözetim altında tuttular."
    },
    "IGUI_ALifeUI_0a1cd889671dcedb": {
      "tr": "Raporlar yavaş yavaş geldi. Kontrollerin ne zaman biteceğini kimse söylemiyordu."
    },
    "IGUI_ALifeUI_5a964aab7bf311ba": {
      "tr": "Gözaltı hücresinin kapısı kilitli kaldı. Kararlarını hâlâ bekliyordun."
    },
    "IGUI_ALifeUI_7b9879a31928f326": {
      "tr": "NE OLDUĞUNU BİLİYORLARDI"
    },
    "IGUI_ALifeUI_2e86133c4e0a92c6": {
      "tr": "Ordu seni asker gözetiminde üsse götürdü. Öldürdüklerinin haberi senden önce onlara ulaşmıştı."
    },
    "IGUI_ALifeUI_794e5d1d36a3a5e7": {
      "tr": "Avluda sekiz asker bekliyordu. Seni duvarın önüne götürdüler."
    },
    "IGUI_ALifeUI_377ceb7104be24e5": {
      "tr": "İnfaz edildin. Sabah olduğunda avlu yine bomboştu."
    },
    "IGUI_ALifeUI_2ba3f7fa6592e9c3": {
      "tr": "ONLARA YUVA KURDUN"
    },
    "IGUI_ALifeUI_399727f273aeac10": {
      "tr": "İlk sığınaklar sessiz bir vadide kuruldu. İnsanların kalabileceği bir yer hazırlamalarına yardım ettin."
    },
    "IGUI_ALifeUI_5fd7b86b6db557a9": {
      "tr": "Ardından başka çatılar yükseldi. Sonra bir duvar örüldü. Kamp dedikleri yer zamanla bir yerleşime dönüştü."
    },
    "IGUI_ALifeUI_3f0c27ff26cc5953": {
      "tr": "Yıllar sonra bile o duvarların ardında ışıklar yanıyordu. Kurulmasına yardım ettiğin yer büyümüştü."
    },
    "IGUI_ALifeUI_4588e8f5264456b2": {
      "tr": "SESSİZCE ÇEKİP GİTTİN"
    },
    "IGUI_ALifeUI_01415ba91e3bdba4": {
      "tr": "Uçak pistinden tek başına uzaklaştın. Kalmak için bir nedenin yoktu."
    },
    "IGUI_ALifeUI_5e903ce22008dcdf": {
      "tr": "Pistin ötesinde yol sakindi. Yürümeye devam ettin."
    },
    "IGUI_ALifeUI_3179905348c311ee": {
      "tr": "Yoldan uzakta bir kulübe buldun. Radyo hep açıktı. Şimdilik bu kadarı yeterdi."
    },
    "IGUI_ALifeUI_1ecf2b4315453b09": {
      "tr": "YOL DEVAM EDİYORDU"
    },
    "IGUI_ALifeUI_7e8d58893c23db62": {
      "tr": "Uçuş bitmişti. Knox'ta yaşananlar hikayenin bir parçası olarak kaldı."
    },
    "IGUI_ALifeUI_3d19dc1106037b02": {
      "tr": "Pisti geride bıraktın. Önünde hâlâ uzun bir yol vardı."
    },
    "IGUI_ALifeUI_5dc26dde09b163b8": {
      "tr": "Yolun ilerisindeki bir kulübede radyoyu dinledin. Sonrasında ne olacağı henüz belli değildi."
    },
    "IGUI_ALifeUI_7f74001127db8ad9": {
      "tr": "ORDU SANA İHTİYAÇ DUYUYORDU"
    },
    "IGUI_ALifeUI_2141cba4208edec0": {
      "tr": "Üste, bir masanın üzerinde üniforma ve tüfek duruyordu. Askere yazıldın."
    },
    "IGUI_ALifeUI_191fd9061c786dc5": {
      "tr": "Sonraki devriyeyle birlikte yürüyüşe çıktın. Hayatta kalmak artık bir görevdi."
    },
    "IGUI_ALifeUI_34b4d32e59294fb6": {
      "tr": "Ölüler gelmeye devam etti. Gözetleme noktasından gözünü onlardan ayırmadın."
    },
    "IGUI_ALifeUI_0cd97c8616539e0a": {
      "tr": "Üste, kim olduğunu araştırırlarken seni içeri kapattılar."
    },
    "IGUI_ALifeUI_15b89bd06cbd2cfb": {
      "tr": "Raporlar yavaş yavaş geldi. Kontrollerin ne kadar süreceğini kimse söylemedi."
    },
    "IGUI_ALifeUI_38ccf26e12388838": {
      "tr": "Hücrenin kapısı kapalı kaldı. Verecekleri kararı hâlâ bekliyordun."
    },
    "IGUI_ALifeUI_74fdb8a331147e98": {
      "tr": "Seni asker gözetiminde üs boyunca yürüttüler. Öldürdüklerinin haberi senden önce ulaşmıştı."
    },
    "IGUI_ALifeUI_71044e1c437feb0a": {
      "tr": "Avluda sekiz asker vardı. Seni duvarın önüne götürdüler."
    },
    "IGUI_ALifeUI_44e882324d1bf1fd": {
      "tr": "Tek yaylım ateşi. Sabah olduğunda avlu yine bomboştu."
    },
    "IGUI_ALifeUI_7b76a0087b97439d": {
      "tr": "Sessiz bir vadide ilk sığınaklar kuruldu. Sen de yapımına yardım ettin."
    },
    "IGUI_ALifeUI_622cdb4b3bcb7109": {
      "tr": "Ardından çatılar, sonra bir duvar. Kamp kasabaya dönüştü."
    },
    "IGUI_ALifeUI_30dad11a0d2bd8f2": {
      "tr": "Yıllar geçti, o duvarların ardında ışıklar hâlâ yanıyordu."
    },
    "IGUI_ALifeUI_60c9471f630a6b90": {
      "tr": "Pistten tek başına ayrıldın. Seni orada tutacak hiçbir şey kalmamıştı."
    },
    "IGUI_ALifeUI_560639d73373385e": {
      "tr": "Çitin ötesinde yol sakindi. Yürümeye devam ettin."
    },
    "IGUI_ALifeUI_68cd55cc45d27ee8": {
      "tr": "Herkesten uzakta bir kulübe, açık bir radyo... Şimdilik bu kadarı yeterdi."
    },
    "IGUI_ALifeUI_3ba46d2a6bc14972": {
      "tr": "Uçuş bitmişti. Knox da seninle kaldı."
    },
    "IGUI_ALifeUI_33a64d6925bce9a7": {
      "tr": "Pisti geride bıraktın. Önünde hâlâ yol vardı."
    },
    "IGUI_ALifeUI_139f235b6d3fe0bf": {
      "tr": "Bir kulübe, bir radyo, upuzun bir gece... Sonrası sana kalmıştı."
    },
    "IGUI_ALifeUI_138fb3fe1ed05cdd": {
      "tr": "Masanın üzerinde bir üniforma, bir tüfek. İmzayı attın."
    },
    "IGUI_ALifeUI_765f22865202d71f": {
      "tr": "Sonraki devriyeye onlarla birlikte çıktın. Artık işin hayatta kalmaktı."
    },
    "IGUI_ALifeUI_2ea8cc0564b426c9": {
      "tr": "Ölüler gelmeye devam etti. Sen de nöbet tuttun."
    },
    "IGUI_ALifeUI_2a8885fb6b924264": {
      "tr": "KİMSE ADINI BİLMİYOR"
    },
    "IGUI_ALifeUI_54146a1104c04c46": {
      "tr": "Pistten tek başına yürüyüp uzaklaştın."
    },
    "IGUI_ALifeUI_51f250dc4e61827f": {
      "tr": "Ne bir kaydın ne bir bayrağın vardı; seni bekleyen kimse de yoktu."
    },
    "IGUI_ALifeUI_38e8688a650d12a4": {
      "tr": "Telsizden durmadan \"Dışarıda kim var?\" diye soruluyordu."
    },
    "IGUI_ALifeUI_21ebfb2620d17406": {
      "tr": "Hiç cevap vermedin."
    },
    "IGUI_ALifeUI_6e2252677f252394": {
      "tr": "Helikopter seni sessiz bir vadiye bıraktı."
    },
    "IGUI_ALifeUI_12867f157338c967": {
      "tr": "Önce birkaç kişi geldi, sonra daha fazlası. Derken bir duvar örüldü."
    },
    "IGUI_ALifeUI_3fd0cddc2af5e970": {
      "tr": "Sana güvendiler, o yüzden kaldılar."
    },
    "IGUI_ALifeUI_40a014541df735c1": {
      "tr": "Yeni bir yer kurmuştun; güvenli bir yer. Artık senindi."
    },
    "IGUI_ALifeUI_703265297f7720b3": {
      "tr": "Ordu seni üsse götürdü."
    },
    "IGUI_ALifeUI_690fda336f08dc91": {
      "tr": "Mahkeme falan olmadı. Dosyanı çoktan okumuşlardı."
    },
    "IGUI_ALifeUI_35ddbd7270942506": {
      "tr": "{zombies} zombi, {humans} insan, {rep}"
    },
    "IGUI_ALifeUI_0728b9f401913335": {
      "tr": "Hemen ardından idam edildin."
    },
    "IGUI_ALifeUI_6252ec9b4c044c30": {
      "tr": "Senin bir canavar olduğunu biliyorlardı."
    },
    "IGUI_ALifeUI_2f301eb52c86f410": {
      "tr": "Ordu, öldürdüğün kişi sayısına baktı ve seni askere aldı."
    },
    "IGUI_ALifeUI_4c99bd0c1ad83b0b": {
      "tr": "Bir üniforma, bir tüfek, isim yerine bir numara."
    },
    "IGUI_ALifeUI_7a41b3cf76b20590": {
      "tr": "Ölüler gelmeye devam ediyordu."
    },
    "IGUI_ALifeUI_3e678fe27eddae41": {
      "tr": "Sen de gelmeye devam ediyordun."
    },
    "IGUI_ALifeUI_16fa18da712a2c41": {
      "tr": "Ne olduğunu araştırırlarken dosyan masada kaldı."
    },
    "IGUI_ALifeUI_2876e7604fb219b4": {
      "tr": "Ordu seni gözaltına aldı. Sicilin, görmezden gelemeyecekleri kuşkular uyandırmıştı."
    }
  }
}
