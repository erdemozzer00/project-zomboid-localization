{
 "_paket": "L2 — Konuşma menüsü satırları (Emirler, Grup, Kış/hava) + fikir nedenleri",
 "_dosya": "IG_UI_lua",
 "satirlar": {
  "IGUI_ALifeUI_6a80ee6f4cb03a6c": {
   "tr": "Samimi davrandın."
  },
  "IGUI_ALifeUI_57cd3f1715a79a20": {
   "tr": "Dostça ayrıldın."
  },
  "IGUI_ALifeUI_64cbad16225a9285": {
   "tr": "Seninle konuşmak kolaydı."
  },
  "IGUI_ALifeUI_0306da1c42cfc858": {
   "tr": "Önemsediğini gösterdin."
  },
  "IGUI_ALifeUI_4c30bdaf2966fda6": {
   "tr": "Yardım teklif ettin."
  },
  "IGUI_ALifeUI_1acc07b0025b77bd": {
   "tr": "Hayatını sordun, içini döktü."
  },
  "IGUI_ALifeUI_40fe11a3748463d4": {
   "tr": "Henüz yeterince tanışmadan fazla kişisel konulara girdin."
  },
  "IGUI_ALifeUI_20555e2721ca1c93": {
   "tr": "Grubu hakkında ayrıntı almak için üsteledin."
  },
  "IGUI_ALifeUI_106ec3115f326bf6": {
   "tr": "Karşılıksız yardım istedin."
  },
  "IGUI_ALifeUI_3e8229c06975d08a": {
   "tr": "Sözlerle üstüne gittin."
  },
  "IGUI_ALifeUI_32ad4e2645814784": {
   "tr": "Yanlış zamanda sordun."
  },
  "IGUI_ALifeUI_4209586731aa075d": {
   "tr": "Aynı şeyi sorup durdun."
  },
  "IGUI_ALifeUI_6e7d304110073c4f": {
   "tr": "Sabrını taşırdın."
  },
  "IGUI_ALifeUI_4c3309973f6106da": {
   "tr": "Geri döndüğüne sevindi."
  },
  "IGUI_ALifeUI_30efac89650e79ad": {
   "tr": "Sorusunu yanıtladın."
  },
  "IGUI_ALifeUI_6fcb0ff65853d9d4": {
   "tr": "Aranıza katılabilir miyim?"
  },
  "IGUI_ALifeUI_1def2d916bd260e2": {
   "tr": "Gruptan seni aralarına almalarını iste. Karara liderleri verir: senin hakkındaki düşünceleri, grubun büyüklüğü ve çevrede olup bitenler belirleyici olur."
  },
  "IGUI_ALifeUI_3408f7280b0d0317": {
   "tr": "Gruptan ayrılıyorum."
  },
  "IGUI_ALifeUI_34b02c0e2db2e5ac": {
   "tr": "Gruptan dostça ayrıl."
  },
  "IGUI_ALifeUI_7d709126301ad05d": {
   "tr": "Ben ne yapayım?"
  },
  "IGUI_ALifeUI_4883567044453257": {
   "tr": "Grup liderinden iş iste."
  },
  "IGUI_ALifeUI_3a6b21e62efe30c1": {
   "tr": "İş neydi, bir daha söyler misin?"
  },
  "IGUI_ALifeUI_0ce499401aedc78e": {
   "tr": "Şu anki işini bir kez daha dinle."
  },
  "IGUI_ALifeUI_25d1099d5d67163f": {
   "tr": "O iş var ya... bitti."
  },
  "IGUI_ALifeUI_4f3a4b7e03c5a905": {
   "tr": "Rapor ver. Getirmen istenen malzemeleri de burada teslim edersin."
  },
  "IGUI_ALifeUI_71a248925d308a8f": {
   "tr": "Biri bize bir hikaye anlatsın."
  },
  "IGUI_ALifeUI_33b7dc9745491c0f": {
   "tr": "Gruptan vakit geçirmek için bir şeyler anlatmasını iste. Yerleştiklerinde ve ortada bir sorun yokken işe yarar."
  },
  "IGUI_ALifeUI_486e17391ce3ad88": {
   "tr": "Emirler"
  },
  "IGUI_ALifeUI_2ddf90a43292a9b9": {
   "tr": "Eller yukarı. Yavaş ve sakin."
  },
  "IGUI_ALifeUI_176fc50e7db79ab7": {
   "tr": "Ellerini göreceğim yerde tut."
  },
  "IGUI_ALifeUI_49ca6acd6ec2dd38": {
   "tr": "Eller yukarı. Hemen."
  },
  "IGUI_ALifeUI_308c24774a1ba87b": {
   "tr": "Silahı bırak. Hemen."
  },
  "IGUI_ALifeUI_307064940ba0b587": {
   "tr": "Yere bırak. Yavaşça."
  },
  "IGUI_ALifeUI_0a6c8502206bd558": {
   "tr": "Silahı indir. Sonuna kadar, yere."
  },
  "IGUI_ALifeUI_5378f0060e8e8b22": {
   "tr": "Bırak onu, ellerini kaldır."
  },
  "IGUI_ALifeUI_607efe2c30db6b59": {
   "tr": "Hepsini ver. Üstünde ne varsa."
  },
  "IGUI_ALifeUI_7f997a392b07e1d8": {
   "tr": "Defol buradan. Hemen."
  },
  "IGUI_ALifeUI_3313130e703245a4": {
   "tr": "Adamlarını al, bu bölgeyi boşalt."
  },
  "IGUI_ALifeUI_6696906114257485": {
   "tr": "Arkama düş. Yürü."
  },
  "IGUI_ALifeUI_6ef90de34e37fa65": {
   "tr": "Önce silahlar. Ver bakalım."
  },
  "IGUI_ALifeUI_0086b0ed427f4301": {
   "tr": "Ceplerini boşalt. Yavaşça."
  },
  "IGUI_ALifeUI_78b2eae83ecca153": {
   "tr": "Ellerini indirebilirsin. Hadi."
  },
  "IGUI_ALifeUI_1c22e0dc6e63ae31": {
   "tr": "Kolluk görevlisiyim. Konuş benimle."
  },
  "IGUI_ALifeUI_747797c87e0250e4": {
   "tr": "Sağlık eğitimim var. Yaralanan var mı?"
  },
  "IGUI_ALifeUI_622566e70047d396": {
   "tr": "Askerlik yaptım. Burada komuta kimde?"
  },
  "IGUI_ALifeUI_23caf0ed54689e70": {
   "tr": "Bir şeyler tamir eder, yapıp kurarım. Yardım lazım mı?"
  },
  "IGUI_ALifeUI_7dfe83337bd953f7": {
   "tr": "Burada aldığın emirler ne?"
  },
  "IGUI_ALifeUI_21b89daf1f52fc57": {
   "tr": "Buradan geçmenin bedeli ne?"
  },
  "IGUI_ALifeUI_7b268a5e5ade5c4b": {
   "tr": "Buralarda insan kabul eden var mı?"
  },
  "IGUI_ALifeUI_7144468f20d33dc5": {
   "tr": "Buradan geçebilir miyim?"
  },
  "IGUI_ALifeUI_0d5a0a7d0fb18de7": {
   "tr": "Güvenini nasıl kazanabilirim?"
  },
  "IGUI_ALifeUI_27e4732173c0fcef": {
   "tr": "Takaslık bir şeyin var mı?"
  },
  "IGUI_ALifeUI_70af98b050113d3d": {
   "tr": "Üşüyor musun?"
  },
  "IGUI_ALifeUI_3d8b718912792616": {
   "tr": "Burada üşümüyorsun, değil mi?"
  },
  "IGUI_ALifeUI_640a68e4664a9b25": {
   "tr": "Donuyor gibisin."
  },
  "IGUI_ALifeUI_013ba54e4ebfab20": {
   "tr": "Sesin pek iyi değil. Üşütmüş müsün?"
  },
  "IGUI_ALifeUI_15088c6443e14244": {
   "tr": "Bu öksürük sana da kötü geliyor mu?"
  },
  "IGUI_ALifeUI_70caff474261259e": {
   "tr": "Hasta mı oluyorsun yoksa?"
  },
  "IGUI_ALifeUI_4a0c03e0137b303e": {
   "tr": "Burada nasıl ısınıyorsun?"
  },
  "IGUI_ALifeUI_41ab1b41245db125": {
   "tr": "Hava bu kadar soğuyunca ne yaparsın?"
  },
  "IGUI_ALifeUI_29d381a82783ec8b": {
   "tr": "Isınmak için bir numaran var mı?"
  },
  "IGUI_ALifeUI_2ceb71ac6a557bf3": {
   "tr": "Öksürüğe iyi gelen bir şey var mı?"
  },
  "IGUI_ALifeUI_75641c9f762ad32b": {
   "tr": "Burada kış nasıl geçer?"
  },
  "IGUI_ALifeUI_3619a3d86106358f": {
   "tr": "Buralarda kış sert mi geçer?"
  },
  "IGUI_ALifeUI_00e0e083388da9f0": {
   "tr": "Kışın hava ne kadar kötüleşir?"
  },
  "IGUI_ALifeUI_6e7f080415ee6957": {
   "tr": "Havalar nasıl, idare ediyor musun?"
  },
  "IGUI_ALifeUI_12f9ecd41491534a": {
   "tr": "Ne hava ama, değil mi?"
  },
  "IGUI_ALifeUI_10a418674f199093": {
   "tr": "Bu havaya ne diyorsun?"
  },
  "IGUI_ALifeUI_526c9d6b62bd6c95": {
   "tr": "Yılın bu zamanını nasıl buluyorsun?"
  },
  "IGUI_ALifeUI_7e7b3dd774422827": {
   "tr": "Mevsim değişiyor. Fark ettin mi?"
  },
  "IGUI_ALifeUI_4a9c063407092f67": {
   "tr": "Bu mevsime şimdilik ne diyorsun?"
  },
  "IGUI_ALifeUI_64eeedd34826448f": {
   "tr": "Hiç böyle kar gördün mü?"
  },
  "IGUI_ALifeUI_62d47738116ddfff": {
   "tr": "Sıcak bastırdı değil mi?"
  },
  "IGUI_ALifeUI_40cf1ee6271c2869": {
   "tr": "Buralarda insan nerede ısınabilir?"
  },
  "IGUI_ALifeUI_0db33131322da373": {
   "tr": "Ateşi yanan bir yer biliyor musun?"
  },
  "IGUI_ALifeUI_2f9430db5a31c8d7": {
   "tr": "Yakınlarda ısınabileceğim bir yer var mı?"
  },
  "IGUI_ALifeUI_66f1e8d712c5a485": {
   "tr": "Bu yıl bir şey eken var mı?"
  }
 }
}