        },
        "IGUI_ALifeUI_0147fe4d61590609": {
            "tr": "Yağmacı kalmadı, adamlarına bir bak"
        },
        "IGUI_ALifeUI_0b3092b514faaf7b": {
            "tr": "Asker kalmadı, bitti"
        },
        "IGUI_ALifeUI_6993a2d57f37e9b2": {
            "tr": "Birlik gitti, teçhizatını kontrol et"
        },
        "IGUI_ALifeUI_6b8bc4ea32f550dc": {
            "tr": "Ortalık yine sessiz, birlik işini bitirdi"
        },
        "IGUI_ALifeUI_574a1eb90c61533a": {
            "tr": "Bitti, memurlar gitti"
        },
        "IGUI_ALifeUI_60adaf223d2e3907": {
            "tr": "Kolluk gitti, kapılara bir bak"
        },
        "IGUI_ALifeUI_70abcd0748d8ddc6": {
            "tr": "Memur kalmadı, yol sakin"
        },
        "IGUI_ALifeUI_25f148fd141e18c3": {
            "tr": "Silahlar sustu, bitti"
        },
        "IGUI_ALifeUI_34d4a461249428a7": {
            "tr": "Ortalık duruldu, eşyalarına bir bak"
        },
        "IGUI_ALifeUI_7fa237142a847108": {
            "tr": "Yerel halk çekip gitti, her şey bitti"
        },
        "IGUI_ALifeUI_059168da327de63c": {
            "tr": "SENİ GÖZETİM ALTINDA TUTTULAR"
        },
        "IGUI_ALifeUI_6c9ee90778e0c50d": {
            "tr": "Nöbetçiler gelenin kim olduğunu araştırırken seni üste alıkoydular."
        },
        "IGUI_ALifeUI_0a1cd889671dcedb": {
            "tr": "Raporlar ağır ağır geliyordu. Araştırma ne zaman bitecek, söyleyen yoktu."
        },
        "IGUI_ALifeUI_5a964aab7bf311ba": {
            "tr": "Nezaret hücresinin kapısı kilitli kaldı. Hala verecekleri kararı bekliyordun."
        },
        "IGUI_ALifeUI_7b9879a31928f326": {
            "tr": "NE OLDUĞUNU BİLİYORLARDI"
        },
        "IGUI_ALifeUI_2e86133c4e0a92c6": {
            "tr": "Ordu seni muhafız eşliğinde üssün içinden geçirdi. Öldürdüklerinin haberi onlara senden önce ulaşmıştı."
        },
        "IGUI_ALifeUI_794e5d1d36a3a5e7": {
            "tr": "Avluda sekiz asker bekliyordu. Seni duvarın dibine götürdüler."
        },
        "IGUI_ALifeUI_377ceb7104be24e5": {
            "tr": "Kurşuna dizildin. Sabah olduğunda avlu yine boştu."
        },
        "IGUI_ALifeUI_2ba3f7fa6592e9c3": {
            "tr": "ONLARI YUVAYA SEN ULAŞTIRDIN"
        },
        "IGUI_ALifeUI_399727f273aeac10": {
            "tr": "İlk barınaklar sessiz bir vadide yükseldi. Kalacak bir yer kurulmasına sen de omuz verdin."
        },
        "IGUI_ALifeUI_5fd7b86b6db557a9": {
            "tr": "Ardından yeni çatılar geldi. Sonra bir duvar. Kamp diye başlayan yer bir yerleşime dönüştü."
        },
        "IGUI_ALifeUI_3f0c27ff26cc5953": {
            "tr": "Yıllar sonra o duvarların ardında ışıklar hala yanıyordu. Kurulmasına emek verdiğin yer büyümüştü."
        },
        "IGUI_ALifeUI_4588e8f5264456b2": {
            "tr": "SESSİZCE ÇEKİP GİTTİN"
        },
        "IGUI_ALifeUI_01415ba91e3bdba4": {
            "tr": "İniş pistinden tek başına yürüyüp gittin. Kalmak için bir sebep yoktu."
        },
        "IGUI_ALifeUI_5e903ce22008dcdf": {
            "tr": "Pistin ötesinde yol sessizdi. Yürümeye devam ettin."
        },
        "IGUI_ALifeUI_3179905348c311ee": {
            "tr": "Yoldan uzakta bir kulübe buldun. Telsiz açık kaldı. Şimdilik bu kadarı yetiyordu."
        },
        "IGUI_ALifeUI_1ecf2b4315453b09": {
            "tr": "YOL SÜRÜP GİTTİ"
        },
        "IGUI_ALifeUI_7e8d58893c23db62": {
            "tr": "Uçuş bitmişti. Knox'ta yaşananlar hikayenin bir parçası olarak kaldı."
        },
        "IGUI_ALifeUI_3d19dc1106037b02": {
            "tr": "Pisti geride bıraktın. Önünde hala bir yol vardı."
        },
        "IGUI_ALifeUI_5dc26dde09b163b8": {
            "tr": "Yolun ötesindeki bir kulübede telsizi dinledin. Bundan sonrası henüz yazılmamıştı."
        },
        "IGUI_ALifeUI_7f74001127db8ad9": {
            "tr": "ORDU SENİ İSTEDİ"
        },
        "IGUI_ALifeUI_2141cba4208edec0": {
            "tr": "Üste bir masanın üstünde bir üniformayla bir tüfek bekliyordu. İmzayı attın."
        },
        "IGUI_ALifeUI_191fd9061c786dc5": {
            "tr": "Bir sonraki devriyeyle yola çıktın. Hayatta kalmak artık bir görevdi."
        },
        "IGUI_ALifeUI_34b4d32e59294fb6": {
            "tr": "Ölülerin ardı arkası kesilmedi. Nöbet yerinden gözünü onlardan ayırmadın."
        },
        "IGUI_ALifeUI_0cd97c8616539e0a": {
            "tr": "Üste kim olduğunu araştırırken seni içeri kapattılar"
        },
        "IGUI_ALifeUI_15b89bd06cbd2cfb": {
            "tr": "Raporlar damla damla geldi. Araştırma ne kadar sürecek, kimse söylemedi"
        },
        "IGUI_ALifeUI_38ccf26e12388838": {
            "tr": "Hücrenin kapısı kapalı kaldı. Hala kararlarını bekliyorsun"
        },
        "IGUI_ALifeUI_74fdb8a331147e98": {
            "tr": "Seni muhafızların arasında üssün içinden yürüttüler. Öldürdüklerinin haberi senden önce varmıştı"
        },
        "IGUI_ALifeUI_71044e1c437feb0a": {
            "tr": "Avluda sekiz asker. Seni duvarın dibine yürüttüler"
        },
        "IGUI_ALifeUI_44e882324d1bf1fd": {
            "tr": "Tek yaylım ateş. Sabaha avlu yine bomboştu"
        },
        "IGUI_ALifeUI_7b76a0087b97439d": {
            "tr": "Sessiz bir vadide ilk barınaklar. Dikilmelerinde senin de emeğin vardı"
        },
        "IGUI_ALifeUI_622cdb4b3bcb7109": {
            "tr": "Sonra çatılar. Sonra bir duvar. Kamp kasabaya döndü"
        },
        "IGUI_ALifeUI_30dad11a0d2bd8f2": {
            "tr": "Yıllar geçti, o duvarların ardında ışıklar hala yanıyor"
        },
        "IGUI_ALifeUI_60c9471f630a6b90": {
            "tr": "Pistten tek başına yürüyüp gittin. Uğruna kalacak bir şey kalmamıştı"
        },
        "IGUI_ALifeUI_560639d73373385e": {
            "tr": "Çitin ötesinde yol sessizdi. Yürümeyi sürdürdün"
        },
        "IGUI_ALifeUI_68cd55cc45d27ee8": {
            "tr": "Herkesten uzak bir kulübe, telsiz açık. Şimdilik bu kadarı yeter"
        },
        "IGUI_ALifeUI_3ba46d2a6bc14972": {
            "tr": "Uçuş bitti. Knox'u içinde taşıyorsun"
        },
        "IGUI_ALifeUI_33a64d6925bce9a7": {
            "tr": "Pist geride kaldı. Önünde hala yol var"
        },
        "IGUI_ALifeUI_139f235b6d3fe0bf": {
            "tr": "Bir kulübe, bir telsiz, uzun bir gece. Bundan sonrası senin elinde"
        },
        "IGUI_ALifeUI_138fb3fe1ed05cdd": {
            "tr": "Masanın üstünde bir üniforma, bir tüfek. İmzayı attın"
        },
        "IGUI_ALifeUI_765f22865202d71f": {
            "tr": "Sonraki devriyede sen de onlarla yürüdün. Hayatta kalmak artık işindi"
        },
        "IGUI_ALifeUI_2ea8cc0564b426c9": {
            "tr": "Ölülerin ardı arkası kesilmedi. Sen de nöbetini tuttun"
        },
        "IGUI_ALifeUI_2a8885fb6b924264": {
            "tr": "ADINI KİMSE BİLMİYOR"
        },
        "IGUI_ALifeUI_54146a1104c04c46": {
            "tr": "İniş pistinden tek başına yürüyüp gittin"
        },
        "IGUI_ALifeUI_51f250dc4e61827f": {
            "tr": "Ne dosyan var ne bayrağın, ne de seni bekleyen biri"
        },
        "IGUI_ALifeUI_38e8688a650d12a4": {
            "tr": "Bir telsiz durmadan orada kim var diye soruyor"
        },
        "IGUI_ALifeUI_21ebfb2620d17406": {
            "tr": "Hiç cevap vermiyorsun"
        },
        "IGUI_ALifeUI_6e2252677f252394": {
            "tr": "Helikopter seni sessiz bir vadiye indirdi"
        },
        "IGUI_ALifeUI_12867f157338c967": {
            "tr": "Önce hayatta kalanlar geldi, sonra daha fazlası, sonra bir duvar yükseldi"
        },
        "IGUI_ALifeUI_3fd0cddc2af5e970": {
            "tr": "İnsanlar sana güvendiği için kaldı"
        },
        "IGUI_ALifeUI_40a014541df735c1": {
            "tr": "Yeni bir yer, güvenli bir yer, üstelik senindi"
        },
        "IGUI_ALifeUI_703265297f7720b3": {
            "tr": "Ordu seni üssüne götürdü"
        },
        "IGUI_ALifeUI_690fda336f08dc91": {
            "tr": "Mahkeme olmadı, dosyanı çoktan okumuşlardı"
        },
        "IGUI_ALifeUI_35ddbd7270942506": {
            "tr": "{zombies} zombi, {humans} insan, {rep}"
        },
        "IGUI_ALifeUI_0728b9f401913335": {
            "tr": "Hemen ardından idam edildin"
        },
        "IGUI_ALifeUI_6252ec9b4c044c30": {
            "tr": "Senin bir canavar olduğunu biliyorlardı"
        },
        "IGUI_ALifeUI_2f301eb52c86f410": {
            "tr": "Ordu öldürdüklerinin sayısını gördü ve seni saflarına kattı"
        },
        "IGUI_ALifeUI_4c99bd0c1ad83b0b": {
            "tr": "Bir üniforma, bir tüfek, ad yerine bir numara"
        },
        "IGUI_ALifeUI_7a41b3cf76b20590": {
            "tr": "Ölüler gelmeye devam ediyor"
        },
        "IGUI_ALifeUI_3e678fe27eddae41": {
            "tr": "Sen de öyle"
        },
        "IGUI_ALifeUI_16fa18da712a2c41": {
            "tr": "Onlar olup biteni incelerken dosyan bir masanın üstünde bekledi."
        },
        "IGUI_ALifeUI_2876e7604fb219b4": {
            "tr": "Ordu seni gözaltına aldı. Sicilin, görmezden gelemeyecekleri sorular doğurmuştu.",
            "onayli_uslup_istisnalari": {
                "sozluk": "Kullanıcı Y8R sözlük işaretini paket onayı kapsamında kabul etti; Türkçe metin aynen korundu."
            }
        }
    }
}
