{
  "_paket": "Y6 — 1.5.0 kaçan metinler: konuşma satırları ve alt notları, 219 (çeviri: harici AI; kalite incelemesi yapılmadı)",
  "_dosya": "IG_UI_lua",
  "satirlar": {
    "IGUI_ALifeUI_5f861f30264ecbc6": {
      "tr": "Burada ne oldu?"
    },
    "IGUI_ALifeUI_5149388a47759eec": {
      "tr": "Kuşatmanın nasıl kapandığını anlatırlar"
    },
    "IGUI_ALifeUI_59c2034844256fa8": {
      "tr": "Etrafınızı saranları azaltayım"
    },
    "IGUI_ALifeUI_1efba5c02725ce2c": {
      "tr": "Alanı temizlerken sana destek olurlar"
    },
    "IGUI_ALifeUI_38066bf57366da6a": {
      "tr": "Açık alanda çatışma riski"
    },
    "IGUI_ALifeUI_4a45aa66341ff5a0": {
      "tr": "Kuşatma kalktı, karşılığında ne alacağım?"
    },
    "IGUI_ALifeUI_384ee29304fb4c52": {
      "tr": "Yükten pay vererek ödeme yaparlar"
    },
    "IGUI_ALifeUI_051dab910e8c96d7": {
      "tr": "Malı ver"
    },
    "IGUI_ALifeUI_281cb0ac4ac32e60": {
      "tr": "Yükü zorla alırsın"
    },
    "IGUI_ALifeUI_4975e84e4efe447a": {
      "tr": "Sana cephe alırlar"
    },
    "IGUI_ALifeUI_19fec01501912a50": {
      "tr": "Bir sonraki teslimat noktası nerede?"
    },
    "IGUI_ALifeUI_3c8fd1d53be77b83": {
      "tr": "Bir sevkiyat rotasını paylaşırlar"
    },
    "IGUI_ALifeUI_32a9c81b35f06662": {
      "tr": "Beni ilgilendirmez"
    },
    "IGUI_ALifeUI_164d38f56a16bc91": {
      "tr": "Sensiz yollarına devam ederler"
    },
    "IGUI_ALifeUI_0e471d850d392875": {
      "tr": "Beni kontrol edin, temizim"
    },
    "IGUI_ALifeUI_0f073e43725fb7cf": {
      "tr": "Geçişine izin verirler"
    },
    "IGUI_ALifeUI_70e54aae4f5906f3": {
      "tr": "Ne arıyorsun?"
    },
    "IGUI_ALifeUI_5ecf5eb461e8eaf9": {
      "tr": "Kontrol noktasının nedenini açıklarlar"
    },
    "IGUI_ALifeUI_08a424c315ee79ef": {
      "tr": "İleride ne var?"
    },
    "IGUI_ALifeUI_683d5cf17c1768e5": {
      "tr": "İlerideki yol konusunda uyarırlar"
    },
    "IGUI_ALifeUI_33d960de6588d87b": {
      "tr": "Durmayacağım"
    },
    "IGUI_ALifeUI_6f22416f171d9239": {
      "tr": "Bu seferlik ses çıkarmazlar"
    },
    "IGUI_ALifeUI_32fa0e5602784e2a": {
      "tr": "Yüzünü unutmazlar"
    },
    "IGUI_ALifeUI_1c0e2be94c1a15c2": {
      "tr": "Dışarıda ne var?"
    },
    "IGUI_ALifeUI_41015933606fc48d": {
      "tr": "Sürüden söz ederler"
    },
    "IGUI_ALifeUI_2e1b10627664caf5": {
      "tr": "Savunmaya yardım edeyim"
    },
    "IGUI_ALifeUI_576e31b64e86e9c2": {
      "tr": "Onlarla birlikte savaşırsın"
    },
    "IGUI_ALifeUI_60db66343ac3003a": {
      "tr": "Sürü çok kalabalık"
    },
    "IGUI_ALifeUI_217415cc121c0f62": {
      "tr": "Artık ortalık sakin"
    },
    "IGUI_ALifeUI_0d2e1fb92aae5a1b": {
      "tr": "Çiftlikteki erzakı paylaşırlar"
    },
    "IGUI_ALifeUI_7b9778bd249bd089": {
      "tr": "Al bunu, aç görünüyorsun"
    },
    "IGUI_ALifeUI_0bbf09227b4a6105": {
      "tr": "Nazik bir söz aralarını yumuşatır"
    },
    "IGUI_ALifeUI_5ea2c9d64d64c87c": {
      "tr": "Bol şans"
    },
    "IGUI_ALifeUI_2bc5d9bf048d644f": {
      "tr": "Sen olmadan da savunmaya devam ederler"
    },
    "IGUI_ALifeUI_5ab847fd7d8b8e36": {
      "tr": "Al bunu, onu bırak"
    },
    "IGUI_ALifeUI_301a2ef71f1096f1": {
      "tr": "Fidye karşılığında rehineyi serbest bırakırlar"
    },
    "IGUI_ALifeUI_5a4d47327ac6ff73": {
      "tr": "Dört konserve verirsin"
    },
    "IGUI_ALifeUI_3a983a8d3620c5f8": {
      "tr": "Onu bırak, yoksa işler çirkinleşecek"
    },
    "IGUI_ALifeUI_2c1fb614649bc46e": {
      "tr": "Blöflerini görürsün"
    },
    "IGUI_ALifeUI_1510647156e7d9fe": {
      "tr": "Ateş açarlar"
    },
    "IGUI_ALifeUI_325d567833a4a209": {
      "tr": "O senin neyin oluyor?"
    },
    "IGUI_ALifeUI_3883b8396540ee23": {
      "tr": "İstedikleri bedeli açıklarlar"
    },
    "IGUI_ALifeUI_0d0c446f14e0418a": {
      "tr": "Beni ilgilendirmez"
    },
    "IGUI_ALifeUI_5e8ae6cf1a217eb4": {
      "tr": "İşin içine karışmadan uzaklaşırsın"
    },
    "IGUI_ALifeUI_670f19af1104a737": {
      "tr": "Alın, yaralılar için bandaj"
    },
    "IGUI_ALifeUI_3364607e4b777b43": {
      "tr": "Karşılığında ilaç verirler"
    },
    "IGUI_ALifeUI_2964b3b01868b591": {
      "tr": "Kapıyı temizleyeceğim"
    },
    "IGUI_ALifeUI_5c8faea64f53925f": {
      "tr": "Pencereleri tutarlar"
    },
    "IGUI_ALifeUI_6c28252143afc921": {
      "tr": "Kapı temiz"
    },
    "IGUI_ALifeUI_3cdf49b14ebde150": {
      "tr": "Ellerinden geleni verirler"
    },
    "IGUI_ALifeUI_2b96f10e68676bbc": {
      "tr": "Durum ne kadar kötü?"
    },
    "IGUI_ALifeUI_2337e11b5f9fdf09": {
      "tr": "Neye ihtiyaçları olduğunu anlatırlar"
    },
    "IGUI_ALifeUI_7428ecca280d288b": {
      "tr": "Kalamam"
    },
    "IGUI_ALifeUI_47a5df5a0d6fdb74": {
      "tr": "Sensiz çalışmaya devam ederler"
    },
    "IGUI_ALifeUI_22e4011d5fcbbc66": {
      "tr": "Al, bir bidon benzin"
    },
    "IGUI_ALifeUI_27cfd974088b8640": {
      "tr": "Karşılığında yol azığı verirler"
    },
    "IGUI_ALifeUI_047196fe3210aa04": {
      "tr": "Sen işini hallet, yolu ben gözlerim"
    },
    "IGUI_ALifeUI_27793f8e7aa9446b": {
      "tr": "Onlar çalışırken nöbet tutarsın"
    },
    "IGUI_ALifeUI_28d1090416d002ee": {
      "tr": "Bir saatini alır"
    },
    "IGUI_ALifeUI_0528c50651b398db": {
      "tr": "Çalışıyor mu artık?"
    },
    "IGUI_ALifeUI_1bca5074632ae4ae": {
      "tr": "Yükten pay vererek teşekkür ederler"
    },
    "IGUI_ALifeUI_256165dd5fa828de": {
      "tr": "Nereye gidiyordun?"
    },
    "IGUI_ALifeUI_406c7ea024a27e76": {
      "tr": "Yolculuklarından söz ederler"
    },
    "IGUI_ALifeUI_2ae3fe4d6df88e6d": {
      "tr": "Kusura bakmayın, verecek bir şeyim yok"
    },
    "IGUI_ALifeUI_00e17a782caebf58": {
      "tr": "Çalışmaya devam ederler"
    },
    "IGUI_ALifeUI_38a943c95f350c86": {
      "tr": "Buralarda yaralarımı nerede sarabilirim?"
    },
    "IGUI_ALifeUI_0ecf5fdb147e53d6": {
      "tr": "Dinlenebileceğin sakin bir yer tarif ederler"
    },
    "IGUI_ALifeUI_5d4dad734e822d7f": {
      "tr": "Yaralı görünüyorsun, yardıma ihtiyacın var mı?"
    },
    "IGUI_ALifeUI_188e4e455bd9297d": {
      "tr": "Durumun aslında ne kadar kötü olduğunu anlatırlar"
    },
    "IGUI_ALifeUI_396f94193763a03d": {
      "tr": "Hava karardıktan sonra dışarıda olmak güvenli mi?"
    },
    "IGUI_ALifeUI_7d4232825c133eb0": {
      "tr": "Geceleri nelerin dolaştığını anlatırlar"
    },
    "IGUI_ALifeUI_7b8b87645f57f160": {
      "tr": "Sen dinlenirken biri nöbet tutuyor mu?"
    },
    "IGUI_ALifeUI_77e49adf58277bfc": {
      "tr": "Uyurken nasıl güvende kaldıklarını öğrenirsin"
    },
    "IGUI_ALifeUI_73d091d6576c2c79": {
      "tr": "Şu hava geçene kadar bekleyebileceğim kuru bir yer var mı?"
    },
    "IGUI_ALifeUI_116eac23659e422a": {
      "tr": "Yağmurdan kaçabileceğin bir yer söylerler"
    },
    "IGUI_ALifeUI_7d063bb815854a76": {
      "tr": "Nasıl ısınıyorsun?"
    },
    "IGUI_ALifeUI_15c0f07b3c9b5f7d": {
      "tr": "Soğukta hayatta kalmak için bedava tavsiyeler"
    },
    "IGUI_ALifeUI_39ef56cc6fcf3e53": {
      "tr": "Bu sıcağa nasıl dayanıyorsun?"
    },
    "IGUI_ALifeUI_15c3827b3d443f99": {
      "tr": "Sıcakta hayatta kalmak için bedava tavsiyeler"
    },
    "IGUI_ALifeUI_47de320f401fe27b": {
      "tr": "Yanında ne taşıyorsun?"
    },
    "IGUI_ALifeUI_3412c3295928640e": {
      "tr": "Yanıt verirken seni tartarlar"
    },
    "IGUI_ALifeUI_6109f9ae0caf9549": {
      "tr": "Grubunuzun başında kim var?"
    },
    "IGUI_ALifeUI_14ba17f649bf3cdf": {
      "tr": "Grubun nasıl yönetildiğini öğrenirsin"
    },
    "IGUI_ALifeUI_35a3dc407e46cc9e": {
      "tr": "Bu siste dışarıda bir şey görebiliyor musun?"
    },
    "IGUI_ALifeUI_2f11b2ec48f496a8": {
      "tr": "Gördüklerini anlatırlar"
    },
    "IGUI_ALifeUI_0995c1202945845f": {
      "tr": "Karda hiç ayak izi gördün mü?"
    },
    "IGUI_ALifeUI_766e0cdd61b1f27c": {
      "tr": "Kimin izlerini gördüklerini söylerler"
    },
    "IGUI_ALifeUI_121dbfbd70c1fb65": {
      "tr": "Sence bu fırtına yakında diner mi?"
    },
    "IGUI_ALifeUI_116afa076b614752": {
      "tr": "Havanın nasıl göründüğünü söylerler"
    },
    "IGUI_ALifeUI_0ac358dd152d7643": {
      "tr": "Bir şeyler ye, su iç"
    },
    "IGUI_ALifeUI_0a9dbf350f64b485": {
      "tr": "Günde bir kez çantandan bir öğün yemek ve biraz su harcanır"
    },
    "IGUI_ALifeUI_362e77280c76598a": {
      "tr": "Nasıl dayanıyorsun?"
    },
    "IGUI_ALifeUI_4e50d3f057b6dee7": {
      "tr": "Her yemek verdiğin günün ardından söyleyecek yeni bir şeyleri olur"
    },
    "IGUI_ALifeUI_50ffa13c707cce33": {
      "tr": "Senin tayfan nerede kalıyor?"
    },
    "IGUI_ALifeUI_7371662b1c77b4cf": {
      "tr": "Karnı doymuş ve sakinleşmiş bir esir yerlerini söyleyip haritanda işaretleyebilir"
    },
    "IGUI_ALifeUI_062f7be7635b9db5": {
      "tr": "Her esir için günde bir deneme hakkı"
    },
    "IGUI_ALifeUI_09691071366c0e23": {
      "tr": "Konuş, yoksa işin daha da kötüleşecek"
    },
    "IGUI_ALifeUI_2250134d29ee3b34": {
      "tr": "Güçlü olman ya da elinde bir silah bulunması gerekir; esirin direncini kırabilir"
    },
    "IGUI_ALifeUI_5de4ad9f31b7bb2f": {
      "tr": "Güven kaybettirir, itibarını zedeler"
    },
    "IGUI_ALifeUI_7d2ffeca0afddb83": {
      "tr": "Çek git, artık özgürsün"
    },
    "IGUI_ALifeUI_7edfa0ee1a9ebec3": {
      "tr": "Gider ve eski hayatına dönerler"
    },
    "IGUI_ALifeUI_48043c5d1093c17e": {
      "tr": "Seni teslim ediyorum"
    },
    "IGUI_ALifeUI_6257dee724655a14": {
      "tr": "Yakında asker, polis ya da sağlık görevlileri bulunmalı; itibarın artar"
    },
    "IGUI_ALifeUI_013e2d5c2bc7ed6e": {
      "tr": "Sakinleşmiş ve karnı tok bir esir ekibine katılabilir"
    },
    "IGUI_ALifeUI_4c3379c10c2d1639": {
      "tr": "Güven gerektirir"
    },
    "IGUI_ALifeUI_175d35b30bbc7af8": {
      "tr": "Bu iş burada bitecek"
    },
    "IGUI_ALifeUI_1d53d4d26c798d03": {
      "tr": "Esiri öldürürsün"
    },
    "IGUI_ALifeUI_713b0ca34bb459e0": {
      "tr": "Bunu duyan herkes unutmaz"
    },
    "IGUI_ALifeUI_4e5f0234590a1e5c": {
      "tr": "Bir şeyini kaybetmiş gibisin"
    },
    "IGUI_ALifeUI_50cc1da007ba84c8": {
      "tr": "Ona ne olduğunu sor"
    },
    "IGUI_ALifeUI_7f413f256028a41c": {
      "tr": "Neden gidip kendin almıyorsun?"
    },
    "IGUI_ALifeUI_5132d79c45dc2958": {
      "tr": "Neden kendisinin gitmediğini sor"
    },
    "IGUI_ALifeUI_70c543cd2371a273": {
      "tr": "Benim çıkarım ne?"
    },
    "IGUI_ALifeUI_63e7c56b2e0a100e": {
      "tr": "Ne ödeyebileceğini sor"
    },
    "IGUI_ALifeUI_5b3e4eca034fb27a": {
      "tr": "Pekâlâ. Çantalarını geri getireceğim"
    },
    "IGUI_ALifeUI_3854744019e64456": {
      "tr": "Geride Kalanlar görevini başlatır"
    },
    "IGUI_ALifeUI_0c0cd67b26c2ab7e": {
      "tr": "Teklifi reddet. Sonradan fikrini değiştirebilirsin"
    },
    "IGUI_ALifeUI_75b4c5320f096543": {
      "tr": "Şu çantaların meselesine gelirsek..."
    },
    "IGUI_ALifeUI_1bcd1ea57284ba9e": {
      "tr": "İşi yeniden gündeme getir"
    },
    "IGUI_ALifeUI_4fa0d7636ae39969": {
      "tr": "O yer neredeydi?"
    },
    "IGUI_ALifeUI_52baf58e3c6ade2f": {
      "tr": "Yol tarif eder"
    },
    "IGUI_ALifeUI_7f77a53e1fe62512": {
      "tr": "Al. Çantan."
    },
    "IGUI_ALifeUI_7614a5946f05a0eb": {
      "tr": "Dell'e çantasını verip görevi tamamlarsın"
    },
    "IGUI_ALifeUI_64c890d30dac702f": {
      "tr": "Six Mile aldı. Üzgünüm"
    },
    "IGUI_ALifeUI_511bca620289c48e": {
      "tr": "Olanları anlat"
    },
    "IGUI_ALifeUI_05aef045101d038b": {
      "tr": "Görevden vazgeçersin"
    },
    "IGUI_ALifeUI_78a107ed1b6d78a4": {
      "tr": "Nasıl dayanıyorsun, Dell?"
    },
    "IGUI_ALifeUI_449ed3e53eff4022": {
      "tr": "Sadece sohbet et"
    },
    "IGUI_ALifeUI_4741dff81d48ccff": {
      "tr": "Pekâlâ. Al çantayı. Ben gidiyorum"
    },
    "IGUI_ALifeUI_1e42efeb651e38e9": {
      "tr": "Çantayı teslim edip sağ salim uzaklaşırsın"
    },
    "IGUI_ALifeUI_5a398ef90f7fd721": {
      "tr": "Dell'in bütün ekibi çatıda, Wade"
    },
    "IGUI_ALifeUI_3c3154e54a7f0ee0": {
      "tr": "Blöf yaparsın. Silah, zırh ve iyi itibar şansını artırır"
    },
    "IGUI_ALifeUI_634f795074905ffd": {
      "tr": "İçindekiler ikimize de yeter"
    },
    "IGUI_ALifeUI_503ef4aa0ab48ce3": {
      "tr": "Çantadakilerin yarısını onlara verirsin"
    },
    "IGUI_ALifeUI_7bb28f19374f418b": {
      "tr": "Burada olacağımı nereden bildin?"
    },
    "IGUI_ALifeUI_232f7e7153d676c6": {
      "tr": "Ona sor"
    },
    "IGUI_ALifeUI_01690b984e905fb1": {
      "tr": "Asla olmaz, Wade"
    },
    "IGUI_ALifeUI_79c1c4f037bb446a": {
      "tr": "Reddedersin. Ateş açarlar"
    },
    "IGUI_ALifeUI_31bcd02b4d4c849b": {
      "tr": "Beni neden istiyorsun?"
    },
    "IGUI_ALifeUI_1b526ea242867dbc": {
      "tr": "Sana güvenmiyorum"
    },
    "IGUI_ALifeUI_4ab8b87a6dfc4f3b": {
      "tr": "Anlaşıldı, devam edin"
    },
    "IGUI_ALifeUI_51c172ff578ea1cb": {
      "tr": "O zaman niye kullanıyorsun"
    },
    "IGUI_ALifeUI_297f02152092b271": {
      "tr": "Orada olacağım"
    },
    "IGUI_ALifeUI_50e2284e2dec3f71": {
      "tr": "Komutanlık beni tanıyor, o çatıda olacağım"
    },
    "IGUI_ALifeUI_3290d94974f3ec7f": {
      "tr": "O kuleyi tanıyorum, o çatıda olacağım"
    },
    "IGUI_ALifeUI_4e7e72313acae719": {
      "tr": "Bir düşüneyim"
    },
    "IGUI_ALifeUI_4d1d401b331468c8": {
      "tr": "Bunun bana faydası ne olacak"
    },
    "IGUI_ALifeUI_4e3ca12c0b98c35b": {
      "tr": "Siktirin gidin, asker bozuntuları"
    },
    "IGUI_ALifeUI_3fceca07297c0c50": {
      "tr": "O subay kim"
    },
    "IGUI_ALifeUI_229874d37020d449": {
      "tr": "Kapatıyorum"
    },
    "IGUI_ALifeUI_77afff30262a0610": {
      "tr": "O zaman orada olacağım"
    },
    "IGUI_ALifeUI_6a95bf3643980cad": {
      "tr": "Bu bir tuzağa benziyor"
    },
    "IGUI_ALifeUI_745fdf651ea5358e": {
      "tr": "Bir daha düşüneyim"
    },
    "IGUI_ALifeUI_52a2f29f785ad5a3": {
      "tr": "Peki, orada olacağım"
    },
    "IGUI_ALifeUI_4963ab951ebac5d3": {
      "tr": "Neden bu kadar çaresizsin"
    },
    "IGUI_ALifeUI_78c81e1926cf4be6": {
      "tr": "Bana gece yarısına kadar süre verin"
    },
    "IGUI_ALifeUI_5d9ae57049c8fe25": {
      "tr": "Hayır, beni listenizden çıkarın"
    },
    "IGUI_ALifeUI_33e854496aae21a8": {
      "tr": "Peki, sözümü geri alıyorum"
    },
    "IGUI_ALifeUI_12fc16af7170a925": {
      "tr": "Yaklaş da ateş edeyim"
    },
    "IGUI_ALifeUI_4e5d95c40236d54d": {
      "tr": "Duydun beni, asker artığı"
    },
    "IGUI_ALifeUI_2989c7c87ad2e9c9": {
      "tr": "Boş verin, sinirle söyledim"
    },
    "IGUI_ALifeUI_539397650b1d9871": {
      "tr": "Daha yüksek sesle söyleyin de Knox da duysun"
    },
    "IGUI_ALifeUI_09eee55f46d9c512": {
      "tr": "Helikopterinizi gönderin, tüfekle bekleyeceğim"
    },
    "IGUI_ALifeUI_1e2ae5052d72c4a1": {
      "tr": "Bir daha söyleyin"
    },
    "IGUI_ALifeUI_737073274662136e": {
      "tr": "Yine de hayır"
    },
    "IGUI_ALifeUI_5ec3b8fd42a6d6f0": {
      "tr": "Eminim, beni unutun"
    },
    "IGUI_ALifeUI_5a6cc4f44c3b3e2d": {
      "tr": "Neden ben"
    },
    "IGUI_ALifeUI_1c4c1504302c4946": {
      "tr": "Bekleyin, geliyorum"
    },
    "IGUI_ALifeUI_5fb9f97306995af2": {
      "tr": "Bu kadarı yetmez"
    },
    "IGUI_ALifeUI_6c61c3504e3df793": {
      "tr": "Yanımdakiler de gelebilir mi"
    },
    "IGUI_ALifeUI_26c6eded3f219dea": {
      "tr": "Ne teklif ediyorsun"
    },
    "IGUI_ALifeUI_440af6557a2f51a8": {
      "tr": "Peki ya Knox ve karantina"
    },
    "IGUI_ALifeUI_635831f10ac2e2ba": {
      "tr": "Aslında kimsin"
    },
    "IGUI_ALifeUI_79b07344500348dc": {
      "tr": "Peki, yeterince dinledim"
    },
    "IGUI_ALifeUI_0d3b800d6baeb7a0": {
      "tr": "Anladım"
    },
    "IGUI_ALifeUI_0d41413a5313870f": {
      "tr": "Devam edin"
    },
    "IGUI_ALifeUI_2c35ef31382504c1": {
      "tr": "Üzüldüm"
    },
    "IGUI_ALifeUI_01589a65339d2399": {
      "tr": "Haklısın, geliyorum"
    },
    "IGUI_ALifeUI_6eb978b4246c9f85": {
      "tr": "Kim soruyor"
    },
    "IGUI_ALifeUI_1f4d833800585e94": {
      "tr": "Susup dinleyeyim"
    },
    "IGUI_ALifeUI_5d610f74734db721": {
      "tr": "Kuleyi kendim temizlerim"
    },
    "IGUI_ALifeUI_6781afec03cffd09": {
      "tr": "O zaman havadan destek verin"
    },
    "IGUI_ALifeUI_22d39e413f7a7141": {
      "tr": "Bu benim için fazla tehlikeli"
    },
    "IGUI_ALifeUI_151a932026af83f4": {
      "tr": "Peki, konuya dönelim"
    },
    "IGUI_ALifeUI_28938113765093c3": {
      "tr": "Buyurun, dinliyorum"
    },
    "IGUI_ALifeUI_7be8dd943aa64d1e": {
      "tr": "Beni nasıl buldun"
    },
    "IGUI_ALifeUI_124991ec52f3bd45": {
      "tr": "Açık kanal mı? Bunu başka kim duyuyor"
    },
    "IGUI_ALifeUI_6bceba123c9567cc": {
      "tr": "Burada yalnız değilim"
    },
    "IGUI_ALifeUI_316eddb97a728c84": {
      "tr": "O zaman hepimiz burada kalırız"
    },
    "IGUI_ALifeUI_1c4b529b11d76dcf": {
      "tr": "İki kişilik yer verin, yoksa anlaşma yok"
    },
    "IGUI_ALifeUI_13f19c7c3e4a503e": {
      "tr": "O zaman tek başıma gelirim"
    },
    "IGUI_ALifeUI_18c83e5444719aab": {
      "tr": "Komutanlığa sorun, yer açarlar"
    },
    "IGUI_ALifeUI_6a6604f671bb9d3f": {
      "tr": "Subayınızı hatta bağlayın"
    },
    "IGUI_ALifeUI_640948a57292f05e": {
      "tr": "Asker olduğunuzu kanıtlayın"
    },
    "IGUI_ALifeUI_02b440e41601e975": {
      "tr": "Boş verin"
    },
    "IGUI_ALifeUI_79baa4a01662f5f8": {
      "tr": "Pekâlâ"
    },
    "IGUI_ALifeUI_04f5773833c9d8eb": {
      "tr": "Otuz dakika yetmez, daha fazla süre verin"
    },
    "IGUI_ALifeUI_5ba4015774af2905": {
      "tr": "O zaman gelmiyorum"
    },
    "IGUI_ALifeUI_359628110e2ae7f6": {
      "tr": "Anladım"
    },
    "IGUI_ALifeUI_69263ba92930d77a": {
      "tr": "Kule temizlenmiş olacak mı"
    },
    "IGUI_ALifeUI_295919327d0f49b1": {
      "tr": "Hazır olacağım"
    },
    "IGUI_ALifeUI_1bb7ac3112d23d42": {
      "tr": "Yanıma ne almalıyım"
    },
    "IGUI_ALifeUI_2b4af9d23cab49f6": {
      "tr": "Ya gecikirsem"
    },
    "IGUI_ALifeUI_15f0e8a439adc4f7": {
      "tr": "Benimkiler de gelecek"
    },
    "IGUI_ALifeUI_50997674634a0cc2": {
      "tr": "Anlatın"
    },
    "IGUI_ALifeUI_0050ffab2dbe35be": {
      "tr": "Söyle bakalım, hayatta kalan, pişman olduğun bir şey var mı?"
    },
    "IGUI_ALifeUI_328a0af67f61c318": {
      "tr": "Kurtaramadığım herkes"
    },
    "IGUI_ALifeUI_6ef507cd322068e9": {
      "tr": "Hiçbir şeyden pişman değilim"
    },
    "IGUI_ALifeUI_173ad21257aed86f": {
      "tr": "Yanlış kişilere güvenmek"
    },
    "IGUI_ALifeUI_25a9b3a75d9053ba": {
      "tr": "Gereğinden uzun süre kalmak"
    },
    "IGUI_ALifeUI_593e814f0be28a88": {
      "tr": "Aşağıda özleyeceğin bir şey var mı?"
    },
    "IGUI_ALifeUI_7bbeecbe0d971227": {
      "tr": "Sessiz sabahları"
    },
    "IGUI_ALifeUI_5d3da49a7087a6e5": {
      "tr": "Gömdüğüm insanları"
    },
    "IGUI_ALifeUI_21ef15e70b125b0f": {
      "tr": "Hiçbir şeyi, bırak yansın"
    },
    "IGUI_ALifeUI_5d54fc411333595a": {
      "tr": "Sıcak bir yemek ve düzgün bir yatak"
    },
    "IGUI_ALifeUI_6a97deda1bdab164": {
      "tr": "Son soru: Bütün bunlara değdi mi?"
    },
    "IGUI_ALifeUI_4e644fce58f794f2": {
      "tr": "Her saniyesine değdi"
    },
    "IGUI_ALifeUI_6cccb2c150544e0b": {
      "tr": "Yere indiğimizde sor"
    },
    "IGUI_ALifeUI_28c851180926dbbb": {
      "tr": "Geride kalanlara sor"
    }
  }
}