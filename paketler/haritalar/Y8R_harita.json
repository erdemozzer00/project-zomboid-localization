    "200": [
      "IGUI_ALifeUI_3d19dc1106037b02",
      "You left the airstrip behind. There was still a road ahead.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "201": [
      "IGUI_ALifeUI_5dc26dde09b163b8",
      "In a cabin beyond the road, you listened to the radio. What came next was still unwritten.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "202": [
      "IGUI_ALifeUI_7f74001127db8ad9",
      "THE ARMY WANTED YOU",
      [
        "ALifeEndingStory.lua",
        "title",
        "ANLATI BAŞLIĞI"
      ]
    ],
    "203": [
      "IGUI_ALifeUI_2141cba4208edec0",
      "At the base, a uniform and a rifle waited on a desk. You signed on.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "204": [
      "IGUI_ALifeUI_191fd9061c786dc5",
      "You marched out with the next patrol. Survival had become a duty.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "205": [
      "IGUI_ALifeUI_34b4d32e59294fb6",
      "The dead kept coming. From your watchpost, you kept them in sight.",
