    ],
    "183": [
      "IGUI_ALifeUI_6c9ee90778e0c50d",
      "At the base, you were held while the guards checked who had arrived.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "184": [
      "IGUI_ALifeUI_0a1cd889671dcedb",
      "Reports came in slowly. Nobody would say when the checks would end.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "185": [
      "IGUI_ALifeUI_5a964aab7bf311ba",
      "The holding-cell door stayed locked. You were still waiting for their decision.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "186": [
      "IGUI_ALifeUI_7b9879a31928f326",
      "THEY KNEW WHAT YOU WERE",
      [
        "ALifeEndingStory.lua",
        "title",
        "ANLATI BAŞLIĞI"
      ]
    ],
    "187": [
      "IGUI_ALifeUI_2e86133c4e0a92c6",
      "The army took you through the base under guard. Your killings had reached them first.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "188": [
      "IGUI_ALifeUI_794e5d1d36a3a5e7",
      "Eight soldiers waited in the courtyard. You were taken to the wall.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "189": [
      "IGUI_ALifeUI_377ceb7104be24e5",
      "You were executed. By morning, the courtyard was empty again.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "190": [
      "IGUI_ALifeUI_2ba3f7fa6592e9c3",
      "YOU LED THEM HOME",
      [
        "ALifeEndingStory.lua",
        "title",
        "ANLATI BAŞLIĞI"
      ]
    ],
    "191": [
      "IGUI_ALifeUI_399727f273aeac10",
      "The first shelters went up in a quiet valley. You helped make a place to stay.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "192": [
      "IGUI_ALifeUI_5fd7b86b6db557a9",
      "More roofs followed. Then a wall. What began as a camp became a settlement.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "193": [
      "IGUI_ALifeUI_3f0c27ff26cc5953",
      "Years later, lights still burned behind those walls. The place you helped build had grown.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "194": [
      "IGUI_ALifeUI_4588e8f5264456b2",
      "YOU LEFT QUIETLY",
      [
        "ALifeEndingStory.lua",
        "title",
        "ANLATI BAŞLIĞI"
      ]
    ],
    "195": [
      "IGUI_ALifeUI_01415ba91e3bdba4",
      "You walked off the landing strip alone. There was no reason to stay.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "196": [
      "IGUI_ALifeUI_5e903ce22008dcdf",
      "Beyond the airstrip, the road was quiet. You kept walking.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "197": [
      "IGUI_ALifeUI_3179905348c311ee",
      "You found a cabin far from the road. The radio stayed on. For now, that was enough.",
      [
        "ALifeEndingStory.lua",
        "liste",
        "ANLATI"
      ]
    ],
    "198": [
      "IGUI_ALifeUI_1ecf2b4315453b09",
      "THE ROAD WENT ON",
      [
        "ALifeEndingStory.lua",
        "title",
        "ANLATI BAŞLIĞI"
      ]
    ],
    "199": [
      "IGUI_ALifeUI_7e8d58893c23db62",
