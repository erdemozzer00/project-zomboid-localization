        "IGUI_ALifeUI_5e31fac8627af478": {
            "tr": "Bildiğin: {note}"
        },
        "IGUI_ALifeUI_49d659340279c93a": {
            "tr": "Henüz görülecek bir şey yok."
        },
        "IGUI_ALifeUI_24f0dcf4622eb1eb": {
            "tr": "En son ne zaman yemek yedin?"
        },
        "IGUI_ALifeUI_54356b3256505924": {
            "tr": "Nereden geliyorsun?"
        },
        "IGUI_ALifeUI_53d961b018c588ca": {
            "tr": "Karşılığında çalışabilir misin?"
        },
        "IGUI_ALifeUI_2d4582d310c8baf9": {
            "tr": "Genelde ne takas edersin?"
        },
        "IGUI_ALifeUI_4340af837c35e967": {
            "tr": "Malları nereden buluyorsun?"
        },
        "IGUI_ALifeUI_5af50333564b88f6": {
            "tr": "Almayacağın bir şey var mı?"
        },
        "IGUI_ALifeUI_6262cbf74ba70346": {
            "tr": "Neden içeride kalalım? Dışarıda ne var?",
            "not": "G \"Neden içeride kalıyorsun?\" yanlış: polis evdekilere içeride kalın diyor, oyuncu nedenini soruyor."
        },
        "IGUI_ALifeUI_21ed47bb597d1403": {
            "tr": "Emri kim verdi?"
        },
        "IGUI_ALifeUI_188d53011a199785": {
            "tr": "Kimliğini görebilir miyim?"
        },
        "IGUI_ALifeUI_167dea08670ac0da": {
            "tr": "Bu sayım ne için?"
        },
        "IGUI_ALifeUI_7502b2912e95b285": {
            "tr": "Liste ne olacak?"
        },
        "IGUI_ALifeUI_7b5401863f5e17f4": {
            "tr": "Yardım gelecek mi?"
        },
        "IGUI_ALifeUI_01c419e02e294edb": {
            "tr": "Silahları neden istiyorsun?"
        },
        "IGUI_ALifeUI_770df055424c9faa": {
            "tr": "Geri alacak mıyım?"
        },
        "IGUI_ALifeUI_5a5c44ac68d7d40a": {
            "tr": "Hangi karakoldansın?"
        },
        "IGUI_ALifeUI_3e1888d351c2ec5b": {
            "tr": "Amirin kim?",
            "not": "G \"Çavuşun\": bunlar polis kılığında; polis için \"amir\" daha doğal."
        },
        "IGUI_ALifeUI_1d41ccf44deba9f4": {
            "tr": "Arama emri ne için?"
        },
        "IGUI_ALifeUI_7b62d60c7cfbeb84": {
            "tr": "Dün gece nerede uyudun?"
        },
        "IGUI_ALifeUI_694035706eaeea70": {
            "tr": "Bir şeyden mi kaçıyorsun?"
        },
        "IGUI_ALifeUI_188d04ec36676525": {
            "tr": "Burada ne işe yararsın?"
        },
        "IGUI_ALifeUI_6fe5edce22027441": {
            "tr": "Seni ne kovalıyor?"
        },
        "IGUI_ALifeUI_27945c251202d632": {
            "tr": "Kaç tane var?"
        },
        "IGUI_ALifeUI_2e60781a48d078a0": {
            "tr": "Nereye gittiğini gördüler mi?"
        },
        "IGUI_ALifeUI_7c8efb07022150a6": {
            "tr": "Nasıl oldu?"
        },
        "IGUI_ALifeUI_0a94d5be0b86c141": {
            "tr": "Mikrop kaptı mı?",
            "not": "\"Enfekte mi?\" yara için konuşma dilinde \"mikrop kapmak\"."
        },
        "IGUI_ALifeUI_5df9375d25c78ae2": {
            "tr": "İlacın var mı?"
        },
        "IGUI_ALifeUI_4d1214f06bf2848a": {
            "tr": "Kimin adamısın?",
            "not": "Haraççı sahnesi: \"Kiminlesin?\" yerine yerinde ağız."
        },
        "IGUI_ALifeUI_65217a13521815e8": {
            "tr": "Hayır dersem ne olur?"
        },
        "IGUI_ALifeUI_71aeec312d946103": {
            "tr": "Başka kimlerden haraç topluyorsun?"
        },
        "IGUI_ALifeUI_331fddc5627b125c": {
            "tr": "Üç değil, iki malzeme"
        },
        "IGUI_ALifeUI_153fa83a7887883c": {
            "tr": "Ne tür insanlar?"
        },
        "IGUI_ALifeUI_7340852d7bad2124": {
            "tr": "Hangi yöne gidiyorlardı?"
        },
        "IGUI_ALifeUI_4e9ad7f5541066eb": {
            "tr": "Kaç kişiydiler?"
        },
        "IGUI_ALifeUI_6fd6d79632500f69": {
            "tr": "Bunu nerede buldun?"
        },
        "IGUI_ALifeUI_3150a9ad47624404": {
            "tr": "Yakınında kimseyi gördün mü?"
        },
        "IGUI_ALifeUI_699ccc720a077c24": {
            "tr": "Gerçekten teşekkür ederim",
            "not": "U3'teki \"Sağ ol, gerçekten\" (Thanks, I mean it) ile aynı çıkmasın."
        },
        "IGUI_ALifeUI_2db2393b1f2318bb": {
            "tr": "Ne kadar içtin?"
        },
        "IGUI_ALifeUI_654e4cc83ac8aca2": {
            "tr": "Evin nerede?"
        },
        "IGUI_ALifeUI_5d2936ae2c0a6fe9": {
            "tr": "Evine git de ayıl biraz",
            "not": "G \"Eve git ve uykuyla geçir\" anlaşılmıyor (sarhoş sahnesi)."
        },
        "IGUI_ALifeUI_420a0a9937d06407": {
            "tr": "Nasıl bir ayin bu?"
        },
        "IGUI_ALifeUI_09089f2b058cd623": {
            "tr": "Ayin nerede oluyor?"
        },
        "IGUI_ALifeUI_2602df266b5cc13a": {
            "tr": "Bağış da alıyor musun?"
        },
        "IGUI_ALifeUI_4574f2916d15f19b": {
            "tr": "Sağ ol ama istemem"
        },
        "IGUI_ALifeUI_4b73f01f5f37e8d7": {
            "tr": "Bugün olmaz, sağ ol"
        },
        "IGUI_ALifeUI_0c26ffe40a4a86e3": {
            "tr": "Neleri tedavi ediyorsun?"
        },
        "IGUI_ALifeUI_6074ac996bc17b9b": {
            "tr": "Ücreti ne kadar?"
        },
        "IGUI_ALifeUI_7f7cdefb02a95c58": {
            "tr": "Eğitimini nerede aldın?"
        },
        "IGUI_ALifeUI_2dd445ac614381a4": {
            "tr": "Diploman var mı?",
            "not": "Doktor için \"ruhsat\" yerine \"diploma\"."
        },
        "IGUI_ALifeUI_21fbf2312b43632c": {
            "tr": "Not kimden?"
        },
        "IGUI_ALifeUI_0d8492ef634ed33b": {
            "tr": "İçinde ne var?"
        },
        "IGUI_ALifeUI_4f31654f1908ac00": {
            "tr": "Neden kendin götürmüyorsun?"
        },
        "IGUI_ALifeUI_0f5738d65b24a53e": {
            "tr": "Zahmet ettin, sağ ol"
        },
        "IGUI_ALifeUI_54c49c5b656f16a0": {
            "tr": "Ne kadar demiştin?"
        },
        "IGUI_ALifeUI_108fdb1829ad04a4": {
            "tr": "Tam olarak kimsin?"
        },
        "IGUI_ALifeUI_31260ce45e8fc407": {
            "tr": "Ne demek, komşuluk bu",
            "not": "Hafif ağız."
        },
        "IGUI_ALifeUI_6ac64eec44bb6d31": {
            "tr": "Arkadaşına ne oldu?"
        },
        "IGUI_ALifeUI_448f3d674f4800c8": {
            "tr": "Orası tehlikeli mi?"
        },
        "IGUI_ALifeUI_0ebda0bd05cafa88": {
            "tr": "Arkadaşının yanında kaç kişi var?",
            "not": "G \"Yanlarında\" kimi kastettiği belirsiz."
        },
        "IGUI_ALifeUI_3147e2b802223fdb": {
            "tr": "Yanında çocuk var mı?"
        },
        "IGUI_ALifeUI_1890572e51c547d5": {
            "tr": "Evine ne oldu?"
        },
        "IGUI_ALifeUI_31f26fb478b76a55": {
            "tr": "Nasılsın bakalım?"
        },
        "IGUI_ALifeUI_751d77dd6729290e": {
            "tr": "Nerede kalıyordun?"
        },
        "IGUI_ALifeUI_7b6d65282472eba2": {
            "tr": "Biri sana sorun çıkardı mı?"
        },
        "IGUI_ALifeUI_785b337e02d12126": {
            "tr": "Geri döndüğüne sevindim"
        },
        "IGUI_ALifeUI_589091a84debf386": {
            "tr": "Ne konuda yardımcı olabilirsin?"
        },
        "IGUI_ALifeUI_5e59ee037ceb689b": {
            "tr": "Önceki yerinden neden ayrıldın?"
        },
        "IGUI_ALifeUI_0e0ef97012b7c6f2": {
            "tr": "Ne kadar süreden bahsediyoruz?"
        },
        "IGUI_ALifeUI_21369f4a3f973777": {
            "tr": "Buraya geldiğini gören oldu mu?"
        },
        "IGUI_ALifeUI_3b5fb7df1a0d70d2": {
            "tr": "Kuru bir şeyler ister misin?"
        },
        "IGUI_ALifeUI_4928dff3560b4608": {
            "tr": "Ne kadar sürecek?"
        },
        "IGUI_ALifeUI_615fbaa01479f599": {
            "tr": "Ne zamandır böyle?"
        },
        "IGUI_ALifeUI_18b666f4514b8a33": {
            "tr": "Neresi acıyor?"
        },
        "IGUI_ALifeUI_5b5780933da8f69e": {
            "tr": "Bunun için ilaç falan içtin mi?",
            "not": "G \"bir şey aldın mı\" satın almak gibi okunuyor."
        },
        "IGUI_ALifeUI_050ded612ec97d0d": {
            "tr": "Bana geldiğine sevindim"
        },
        "IGUI_ALifeUI_15c185c8462b432b": {
            "tr": "Hakkımda ne dediler?"
        },
        "IGUI_ALifeUI_697e0dea5021fa15": {
            "tr": "Hangi radyoydu?",
            "not": "G \"istasyon\": burada radyo kanalı."
        },
        "IGUI_ALifeUI_22f55c841dca1d3f": {
            "tr": "Başka kim duydu?"
        },
        "IGUI_ALifeUI_6c86703f068faa68": {
            "tr": "Söylediğin için sağ ol"
        },
        "IGUI_ALifeUI_65bfcf923075532c": {
            "tr": "Pencereden göz at"
        },
        "IGUI_ALifeUI_7095a5c154abfec6": {
