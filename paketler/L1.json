    "IGUI_ALifeUI_7cd0774c54303d70": {
      "tr": "Senin için ateşe atlar"
    },
    "IGUI_ALifeUI_4f8e68ec737a68de": {
      "tr": "Onunla yiyeceğini ya da suyunu paylaştın."
    },
    "IGUI_ALifeUI_7f9e02985cbd0d35": {
      "tr": "Birinin yarasını sardın."
    },
    "IGUI_ALifeUI_218115a36f79d2a9": {
      "tr": "Onunla omuz omuza savaştın."
    },
    "IGUI_ALifeUI_750ce97b26887575": {
      "tr": "Bir can kurtardın."
    },
    "IGUI_ALifeUI_6c64a612181ea390": {
      "tr": "Dürüst alışveriş yaptın."
    },
    "IGUI_ALifeUI_21d08272544b6c72": {
      "tr": "Sözünü tuttun."
    },
    "IGUI_ALifeUI_41f0835f3428b808": {
      "tr": "Kapıda ona iyi davrandın."
    },
    "IGUI_ALifeUI_785fd2482f238a17": {
      "tr": "Onunla aynı yolu yürüdün."
    },
    "IGUI_ALifeUI_128cc48559d374e2": {
      "tr": "Onu tehdit ettin ama işe yaramadı."
    },
    "IGUI_ALifeUI_47e587f816755bd9": {
      "tr": "Ona kaba davrandın."
    },
    "IGUI_ALifeUI_3c7d22756dc8e5f8": {
      "tr": "Ondan bir şeyler aldın."
    },
    "IGUI_ALifeUI_553e490b64b7e9d6": {
      "tr": "Onlardan birine vurdun."
    },
    "IGUI_ALifeUI_3ba8a17b74bc6ebb": {
      "tr": "Onlardan birini öldürdün."
    },
    "IGUI_ALifeUI_5b191577792d65b0": {
      "tr": "Bir anlaşmayı bozdun."
    },
    "IGUI_ALifeUI_74bc12b0757b1eba": {
      "tr": "Grup için üstüne düşeni yaptın."
    },
    "IGUI_ALifeUI_083a999f4e8ddbb8": {
      "tr": "Bir işte grubu yüzüstü bıraktın."
    },
    "IGUI_ALifeUI_4d68ac8064f14166": {
      "tr": "Zor anda onu yalnız bıraktın."
    },
    "IGUI_ALifeUI_5a396c3f1d4728ec": {
      "tr": "Şimdilik yabancısın; duyduklarına göre yargılıyor."
    },
    "IGUI_ALifeUI_77f61fad38646481": {
      "tr": "Sana bir şey anlatmam."
    },
    "IGUI_ALifeUI_7284137e4d340055": {
      "tr": "O kadar tanımıyorum seni."
    },
    "IGUI_ALifeUI_37cf337e62c44164": {
      "tr": "Daha değil. Sana biraz daha güvenince sor."
    },
    "IGUI_ALifeUI_4c5b6c6b6c26b0b1": {
      "tr": "Adını duyan herkes kapısını kilitliyor. Çoğu seninle dövüşmektense ödemeyi yeğler, kimse sana sırtını dönmez."
    },
    "IGUI_ALifeUI_28a073bd3ec5743e": {
      "tr": "Zalim",
      "not": "En kötü itibar seviyesi. 'Kötü Adam' oyun dilinde kaba duruyor."
    },
    "IGUI_ALifeUI_62e5ed65306577c2": {
      "tr": "İstediğini zorla almanla tanınıyorsun. Yaklaşınca yolcular saklanıyor, kanun adamları seni uzaktan izliyor."
    },
    "IGUI_ALifeUI_4e3ca88165b2b29f": {
      "tr": "Yağmacı",
      "not": "Katalogdaki 'Raider' unvanıyla aynı."
    },
    "IGUI_ALifeUI_6954ac5d664604e3": {
      "tr": "Soygunlarının lafı yayıldı. İnsanlar sen istemeden eşyalarını uzatıyor, kanun da hesabını tutuyor."
    },
    "IGUI_ALifeUI_6747ed6973aa0487": {
      "tr": "Gözü Dönmüş"
    },
    "IGUI_ALifeUI_717647d12673eba3": {
      "tr": "Unutulmayacak sınırları aştın. Dürüst insanlar uzak duruyor ama sert takımlar seni dinler."
    },
    "IGUI_ALifeUI_48ad426653b376bb": {
      "tr": "Kanun Kaçağı"
    },
    "IGUI_ALifeUI_3fd30005085e3803": {
      "tr": "Zaten düşmüş olanlardan alıyorsun. Kimse sana henüz düşman demiyor ama çeteler sana selam vermeye başladı."
    },
    "IGUI_ALifeUI_78a12c573a66c664": {
      "tr": "Akbaba",
      "not": "Düşene vuran fırsatçı; Türkçede de bu anlamda kullanılıyor."
    },
    "IGUI_ALifeUI_21df7720521bb0e5": {
      "tr": "Burada kimsenin senin hakkında anlatacak bir hikâyesi yok. İnsanlar seni nasıl bulursa öyle kabul ediyor."
    },
    "IGUI_ALifeUI_65622aac7d78d7de": {
      "tr": "Birden çok kez el uzattın. Kanun ve siviller seni daha çabuk dinliyor, yardım istemeye gelen de çoğalıyor."
    },
    "IGUI_ALifeUI_37334c6a59289959": {
      "tr": "Yardımsever"
    },
    "IGUI_ALifeUI_28c8a6b2240a4201": {
      "tr": "İnsanlar, belayla aralarına girdiğin günü anlatıyor. Tüccarlar daha adil fiyat istiyor, ihtiyacı olan kapını biliyor."
    },
    "IGUI_ALifeUI_0bb2b0f166b962b0": {
      "tr": "Koruyucu"
    },
    "IGUI_ALifeUI_7dc645461fe6ad18": {
      "tr": "Kanun, aileler ve siviller sözüne güveniyor, yabancılar işini sormadan el sallıyor. Çeteler ise senin gibi birinin evini kolay av sanıyor."
    },
    "IGUI_ALifeUI_72df6d055b6d3e99": {
      "tr": "Şerif",
      "not": "Katalogdaki 'Sheriff' unvanıyla aynı."
    },
    "IGUI_ALifeUI_654887cc6d7e44a3": {
      "tr": "Yaptıklarının hikâyesi senden hızlı yol alıyor. Çoğu kapı sana açılıyor."
    },
    "IGUI_ALifeUI_7c8647955ba0f975": {
      "tr": "Kahraman"
    },
    "IGUI_ALifeUI_620dc07a2044482c": {
      "tr": "Seni hiç görmemiş hayatta kalanlar bile adını biliyor ve hakkında iyi şeyler söylüyor."
    },
    "IGUI_ALifeUI_4e758e4353dae2be": {
      "tr": "Efsane"
    }
  }
}
